#!/bin/sh
# X7 Game: make the OTG port a USB serial port (CDC ACM) for a root shell.
#
# configfs gadget "x7game2": VID 1d6b / PID 0104, device class 02 (CDC) with
# one ACM function - exactly the descriptor NZEUS Deck's USB rescue port uses
# on this kernel and USB driver, which Windows 10/11 opens as a COM port with
# its built-in usbser driver (no driver to install). v0.1.0 used ShallotsOS's
# EF/02/01 "composite" form; Windows put usbccgp in between and PuTTY hung
# opening the port, so this is the proven form. The shell itself runs on
# /dev/ttyGS0 (see /etc/inittab).
# On the PC: PuTTY -> Serial, the new COM port, any speed, flow control None.
G=/sys/kernel/config/usb_gadget/x7game2
mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config || exit 1
test -d /sys/kernel/config/usb_gadget || { echo "x7-usb-gadget: no USB gadget support"; exit 1; }

if ! test -d "$G"; then
	mkdir -p "$G" || exit 1
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	echo 0x0100 > "$G/bcdDevice"
	echo 0x0200 > "$G/bcdUSB"
	echo 0x02 > "$G/bDeviceClass"
	mkdir -p "$G/strings/0x409"
	echo "X7GAME-R36SX-2" > "$G/strings/0x409/serialnumber"
	echo "X7 Game" > "$G/strings/0x409/manufacturer"
	echo "X7 Game USB serial shell" > "$G/strings/0x409/product"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "Serial shell" > "$G/configs/c.1/strings/0x409/configuration"
	echo 250 > "$G/configs/c.1/MaxPower"
	mkdir -p "$G/functions/acm.usb0"
	ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
fi

test -n "$(cat "$G/UDC" 2>/dev/null)" && exit 0
# Plug the gadget into the board's USB device controller (the OTG port,
# 18844000.usb). Normally it is already there; otherwise wait for it in the
# background so the start-up goes on.
bind() {
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	test -n "$udc" || return 1
	if echo "$udc" > "$G/UDC"; then
		echo "<5>x7-usb-gadget: USB serial (acm.usb0 -> /dev/ttyGS0) bound to $udc" > /dev/kmsg
		return 0
	fi
	echo "<4>x7-usb-gadget: could not bind to $udc" > /dev/kmsg
	return 1
}
bind && exit 0
(
	i=0
	while test $i -lt 30; do
		sleep 1
		bind && exit 0
		i=$((i + 1))
	done
	echo "<4>x7-usb-gadget: no USB device controller appeared" > /dev/kmsg
) > /dev/null 2>&1 &
exit 0
