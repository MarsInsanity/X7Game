#!/bin/sh
# X7 Game: getty runs this on the USB serial port instead of asking for a
# user name - a root shell, no password (the cable to your own PC is the
# way in).
export HOME=/root USER=root LOGNAME=root SHELL=/bin/sh TERM=vt100
cd /root 2>/dev/null || cd /
stty sane 2>/dev/null
echo
echo "X7 Game - root shell on the USB cable."
echo "  x7-status       hardware state      tail -f /run/x7-events.log  live events"
echo "  x7-soundtest    play a test sound   x7-colortest   colour test on the screen"
echo "  x7-tf2-probe    find TF2's wiring   poweroff       switch the console off"
exec /bin/sh -l
