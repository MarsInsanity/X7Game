# /etc/inittab - X7 Game (BusyBox init; runlevels are ignored)
#
# The root file system is a read-only squashfs. /tmp, /run and /dev/shm are
# RAM (fstab); /dev is devtmpfs (mounted by the kernel).

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The hardware monitor (power button, volume keys, charger, headphones, TF2)
# and the virtual gamepad the emulators use (x7-padd, "X7 Game Gamepad").
# The monitor's output is the event log, /run/x7-events.log; what it prints
# is thrown away (the screen belongs to the game list). x7-padd's messages
# go to /run/x7-padd.log.
::respawn:/usr/bin/x7-hwmon > /dev/null 2>&1
::respawn:/usr/sbin/x7-padd > /dev/null 2>> /run/x7-padd.log

# The screen: the temporary game list (x7-browser), which starts the
# emulators. Its "System information" page shows the hardware state and the
# latest events (x7-console shows them live, e.g. over the USB shell).
tty1::respawn:/usr/bin/x7-browser

# A root shell on the USB cable (OTG port -> PuTTY, Serial, any speed, then
# press Enter).
ttyGS0::respawn:/usr/libexec/x7-usb-shell

::ctrlaltdel:/sbin/reboot

# Stopping: services first (S00x7boot unmounts the SD card), then everything
# read-only.
::shutdown:/etc/init.d/rcK
::shutdown:/bin/sync
::shutdown:/bin/umount -a -r
