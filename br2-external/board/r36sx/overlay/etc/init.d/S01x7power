#!/bin/sh
# X7 Game: the power-on battery check. If the battery is at or below
# battery_boot_level (x7game.cfg) and no charger is plugged into the DC port,
# say so and switch off again instead of starting on an almost empty battery.
test "$1" = start || exit 0
test -f /run/x7game.conf && . /run/x7game.conf
P=$(ls -d /sys/bus/platform/devices/*.power 2>/dev/null | head -n 1)
test -n "$P" || exit 0
test "$(cat /sys/class/power_supply/charger/online 2>/dev/null)" = 1 && exit 0
sum=0
n=0
for i in 1 2 3 4 5 6 7 8; do
	l=$(sed -n 's/.*battery=\([0-9][0-9]*\).*/\1/p' "$P/stock_levels" 2>/dev/null)
	if test -n "$l" && test "$l" -gt 0; then
		sum=$((sum + l))
		n=$((n + 1))
	fi
done
test "$n" -gt 0 || exit 0
level=$((sum / n))
cutoff=${battery_boot_level:-132}
if test "$level" -le "$cutoff"; then
	echo
	echo "X7 Game: the battery is too low to start (level $level, needs more than $cutoff)."
	echo "Plug a charger into the DC port, then switch on again."
	echo "battery too low at power-on: level $level <= $cutoff" >> /boot/x7game/logs/power.log 2>/dev/null
	sleep 5
	sync
	umount /boot 2>/dev/null
	poweroff -f
fi
exit 0
