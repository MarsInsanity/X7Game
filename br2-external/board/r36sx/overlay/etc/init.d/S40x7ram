#!/bin/sh
# X7 Game: give Linux the memory the AVP co-processor's firmware would use
# (about 79 MiB). The AVP is replaced by a stand-in on the SD card; the
# nzeus-ram driver checks for 10 s that nothing writes that memory before it
# releases it, so this runs in the background after start-up.
test "$1" = start || exit 0
D=$(ls -d /sys/bus/platform/devices/*avp-free-ram 2>/dev/null | head -n 1)
test -n "$D" || exit 0
(
	sleep 3
	case "$(cat "$D/release" 2>/dev/null)" in RELEASED*) exit 0 ;; esac
	before=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	if echo release > "$D/release" 2>/dev/null; then
		after=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
		echo "<5>x7game: AVP memory given to Linux (MemTotal $before -> $after KiB)" > /dev/kmsg
	else
		echo "<4>x7game: AVP memory not released (AVP running?), MemTotal $before KiB" > /dev/kmsg
	fi
) > /dev/null 2>&1 &
exit 0
