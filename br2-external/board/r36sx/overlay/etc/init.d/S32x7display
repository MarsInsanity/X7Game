#!/bin/sh
# X7 Game: display settings from x7game.cfg (both on by default since they
# were confirmed on the console; 0 turns one off).
#   fb_writecombine=1  map the screen write-combined for programs ("uncached
#                      accelerated", kernel patch 0018); x7-fbspeed measures it
#   fb_hwscale=1       let RetroArch's x7fb driver have the display hardware
#                      scale its frames (kernel patch 0019, /run/x7-hwscale)
test "$1" = start || exit 0
test -f /run/x7game.conf && . /run/x7game.conf
P=/sys/module/hc16xx_gma_fb/parameters/mmap_wc
case "$fb_writecombine" in
1) test -w "$P" && echo 1 > "$P" ;;
esac
rm -f /run/x7-hwscale
case "$fb_hwscale" in
1) test -e /sys/bus/platform/devices/1883a000.framebuffer/scale && : > /run/x7-hwscale ;;
esac
exit 0
