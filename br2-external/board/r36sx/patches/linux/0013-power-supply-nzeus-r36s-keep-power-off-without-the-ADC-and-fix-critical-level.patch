From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: X7 Game build <x7game@invalid>
Date: Sun, 22 Nov 2026 14:30:00 -0800
Subject: [PATCH] power: supply: nzeus-r36s-power: keep power-off without the
 ADC and fix the critical level (X7 Game)

An ADC reference that reads 0 at probe (a bootloader that did not start the ADC) no longer fails the whole probe. Only the battery and charger power supplies are left out, with a warning. The restart handler (watchdog), the power-off handler (L01), the power-button poll, stock_levels and voldown are still set up, so "poweroff" and "reboot" keep working instead of only halting.

The capacity level now reports Critical at level <= LEVEL_EMPTY + 2 (130, the default battery_off_level). The old threshold, the bootloader's low level 127, lies below the level where the console dies (128-129), so Critical was never reached.
---
 drivers/power/supply/nzeus-r36s-power.c | 45 ++++++++++++++++---------
 1 file changed, 30 insertions(+), 15 deletions(-)

diff --git a/drivers/power/supply/nzeus-r36s-power.c b/drivers/power/supply/nzeus-r36s-power.c
index d358542d5..44560db76 100644
--- a/drivers/power/supply/nzeus-r36s-power.c
+++ b/drivers/power/supply/nzeus-r36s-power.c
@@ -68,7 +68,6 @@
 
 #define LEVEL_EMPTY	128	/* measured: the console died at 128-129 */
 #define LEVEL_FULL	175
-#define LEVEL_LOW	127	/* bootloader's low-battery threshold */
 #define CHARGER_ON	64	/* NZEUS stock-side threshold */
 #define BUTTON_POLL_MS	50
 #define HOLD_TO_OFF_MS	3000
@@ -128,7 +127,12 @@ static int r36s_battery_get(struct power_supply *psy,
 				    (LEVEL_FULL - LEVEL_EMPTY), 0, 100);
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
-		val->intval = level <= LEVEL_LOW ? POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL :
+		/*
+		 * Critical just above the measured empty level (130, also x7-hwmon's
+		 * default battery_off_level). The bootloader's low threshold (127)
+		 * lies below the level where the console dies, so it never showed.
+		 */
+		val->intval = level <= LEVEL_EMPTY + 2 ? POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL :
 			      level < LEVEL_EMPTY + 10 ? POWER_SUPPLY_CAPACITY_LEVEL_LOW :
 			      level >= LEVEL_FULL ? POWER_SUPPLY_CAPACITY_LEVEL_FULL :
 			      POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
@@ -376,18 +380,25 @@ static int r36s_power_probe(struct platform_device *pdev)
 	platform_set_drvdata(pdev, p);
 	mutex_init(&p->voldown_lock);
 
+	/*
+	 * With the reference at 0 every battery and charger read fails, so they
+	 * are left out. Restart, power-off and the power button do not need the
+	 * ADC and are set up either way (without them "poweroff" and "reboot"
+	 * only halt).
+	 */
 	level = r36s_level(p, 1);
-	if (level < 0)
-		return dev_err_probe(dev, level, "ADC reference reads 0: not configured by the bootloader?\n");
-
-	cfg.drv_data = p;
-	cfg.fwnode = dev_fwnode(dev);
-	p->charger = devm_power_supply_register(dev, &r36s_charger_desc, &cfg);
-	if (IS_ERR(p->charger))
-		return PTR_ERR(p->charger);
-	p->battery = devm_power_supply_register(dev, &r36s_battery_desc, &cfg);
-	if (IS_ERR(p->battery))
-		return PTR_ERR(p->battery);
+	if (level < 0) {
+		dev_warn(dev, "ADC reference reads 0 (bootloader did not start the ADC?): battery and charger not registered\n");
+	} else {
+		cfg.drv_data = p;
+		cfg.fwnode = dev_fwnode(dev);
+		p->charger = devm_power_supply_register(dev, &r36s_charger_desc, &cfg);
+		if (IS_ERR(p->charger))
+			return PTR_ERR(p->charger);
+		p->battery = devm_power_supply_register(dev, &r36s_battery_desc, &cfg);
+		if (IS_ERR(p->battery))
+			return PTR_ERR(p->battery);
+	}
 	ret = device_create_file(dev, &dev_attr_stock_levels);
 	if (ret)
 		return ret;
@@ -403,8 +414,12 @@ static int r36s_power_probe(struct platform_device *pdev)
 		device_remove_file(dev, &dev_attr_stock_levels);
 		return ret;
 	}
-	dev_info(dev, "battery level %d (stock scale), charger level %d; power button %s\n",
-		 level, r36s_level(p, 5), p->power ? "on L14, hold 3 s = power off" : "not described");
+	if (level < 0)
+		dev_info(dev, "power button %s\n",
+			 p->power ? "on L14, hold 3 s = power off" : "not described");
+	else
+		dev_info(dev, "battery level %d (stock scale), charger level %d; power button %s\n",
+			 level, r36s_level(p, 5), p->power ? "on L14, hold 3 s = power off" : "not described");
 	return 0;
 }
 
