diff --git a/drivers/phy/phy-hichip-usb.c b/drivers/phy/phy-hichip-usb.c
index 86aa6cc50..11f3cb3b2 100644
--- a/drivers/phy/phy-hichip-usb.c
+++ b/drivers/phy/phy-hichip-usb.c
@@ -3,6 +3,12 @@
  * HiChip SoCs USB PHY driver
  *
  * Copyright (C) Siarhei Volkau <lis8215@gmail.com>
+ *
+ * NZEUS (linux-port/usbhost/README.md): optional "force VBUS valid" in host
+ * mode, requested by the musb glue with phy_set_mode_ext(PHY_MODE_USB_HOST,
+ * HICHIP_USB_PHY_FORCE_VBUS_VALID) only when the user set
+ * nzeus_host_force_vbus=1. Without that request this driver touches no
+ * register beyond what it did before (UPHY20 is never read or written).
  */
 
 #include <linux/bitfield.h>
@@ -35,11 +41,39 @@
 #define UPHY4_DISCONNECT_THRESHOLD_MASK		GENMASK(7, 4)
 #define UPHY4_DISCONNECT_THRESHOLD_675MV	0xd
 
+/* UPHY20 bit 15: "configure phy vbus/avalid/bvalid = 1" (comment above) */
+#define UPHY20_FORCE_VBUS_VALID			BIT(15)
+/* phy_set_mode_ext() submode, same value in drivers/usb/musb/hc16xx.c */
+#define HICHIP_USB_PHY_FORCE_VBUS_VALID		BIT(0)
+
 struct hichip_usb_phy {
 	struct phy *phy;
 	void __iomem *base;
+	bool vbus_forced;	/* UPHY20 changed by us; uphy20_saved holds the old value */
+	u32 uphy20_saved;
 };
 
+/* Set or undo the forced VBUS-valid bit; no register access if nothing changes. */
+static void hichip_usb_phy_force_vbus(struct phy *phy, bool on)
+{
+	struct hichip_usb_phy *priv = phy_get_drvdata(phy);
+
+	if (on && !priv->vbus_forced) {
+		priv->uphy20_saved = readl(priv->base + REG_UPHY20_OFFSET);
+		writel(priv->uphy20_saved | UPHY20_FORCE_VBUS_VALID,
+		       priv->base + REG_UPHY20_OFFSET);
+		priv->vbus_forced = true;
+		dev_info(&phy->dev, "host: VBUS valid forced (UPHY20 %08x -> %08x)\n",
+			 priv->uphy20_saved,
+			 readl(priv->base + REG_UPHY20_OFFSET));
+	} else if (!on && priv->vbus_forced) {
+		writel(priv->uphy20_saved, priv->base + REG_UPHY20_OFFSET);
+		priv->vbus_forced = false;
+		dev_info(&phy->dev, "VBUS valid no longer forced (UPHY20 %08x)\n",
+			 readl(priv->base + REG_UPHY20_OFFSET));
+	}
+}
+
 static int hichip_usb_phy_init(struct phy *phy)
 {
 	struct hichip_usb_phy *priv = phy_get_drvdata(phy);
@@ -88,17 +122,22 @@ static int hichip_usb_phy_power_off(struct phy *phy)
 static int hichip_usb_phy_set_mode(struct phy *phy,
 				  enum phy_mode mode, int submode)
 {
-	struct hichip_usb_phy *priv = phy_get_drvdata(phy);
-
-	/* This is handled entirely by UTMI register in the musb glue layer.
-	 * So effectively a no-op.
+	/* Host/device itself is handled entirely by the UTMI register in the
+	 * musb glue layer. Only the optional forced VBUS-valid lives here.
 	 */
 	switch (mode) {
 	case PHY_MODE_USB_HOST:
+		/*
+		 * Only switches the force ON. A plain HOST request (the MUSB
+		 * core's own musb_host_setup() sends one) keeps the state;
+		 * DEVICE/OTG (glue exit) undoes it.
+		 */
+		if (submode & HICHIP_USB_PHY_FORCE_VBUS_VALID)
+			hichip_usb_phy_force_vbus(phy, true);
 		break;
 	case PHY_MODE_USB_DEVICE:
-		break;
 	case PHY_MODE_USB_OTG:
+		hichip_usb_phy_force_vbus(phy, false);
 		break;
 	default:
 		return -EINVAL;
@@ -121,7 +160,6 @@ static int hichip_usb_phy_probe(struct platform_device *pdev)
 	struct hichip_usb_phy *priv;
 	struct phy_provider *provider;
 	struct device *dev = &pdev->dev;
-	int err;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
diff --git a/drivers/usb/musb/hc16xx.c b/drivers/usb/musb/hc16xx.c
index 4de86e3af..0788baead 100644
--- a/drivers/usb/musb/hc16xx.c
+++ b/drivers/usb/musb/hc16xx.c
@@ -3,16 +3,45 @@
  * HiChip HC16XX MUSB "glue layer"
  *
  * Copyright (C) 2026, Siarhei Volkau <lis8215@gmail.com>
+ *
+ * NZEUS changes (linux-port/usbhost/README.md), 2026-10-10:
+ *  - per-controller platform data (the old one was a shared static struct)
+ *  - the port mode comes from the device tree "dr_mode":
+ *      "peripheral" (or missing)  gadget only, as before
+ *      "host"                     host only (like the stock 4.4 kernel)
+ *      "otg"                      starts as PERIPHERAL (no ID pin on the R36S)
+ *                                 and offers a user-controllable USB role
+ *                                 switch: /sys/class/usb_role/<dev>-role-switch/role
+ *  - a role change RE-CREATES the MUSB core in the other port mode (unregister
+ *    the musb-hdrc child, register a new one). Host mode is then exactly the
+ *    MUSB core's well-trodden host-only path (session bit set by musb_start()
+ *    when the root hub powers its port), and peripheral mode is exactly the
+ *    boot-time gadget path, so the USB rescue gadget is not changed.
+ *  - .set_mode never sleeps and never changes the mode: the legacy musb sysfs
+ *    "mode" file calls it under a spinlock with interrupts off (the old code
+ *    called phy_power_on(), which takes a mutex, from there).
+ *  - the controller IRQ is switched on/off idempotently (the core's
+ *    request_irq() enables it behind the glue's back, and host mode reaches
+ *    musb_start() while the core is still being registered).
+ *  - optional "force VBUS valid" in host mode through the PHY (off by default,
+ *    nzeus_host_force_vbus sysfs knob; see phy-hichip-usb.c UPHY20).
+ *  - a core whose start-up is deferred (-EPROBE_DEFER, or the core never
+ *    reached .init) makes the glue probe return -EPROBE_DEFER, not a hard
+ *    error, so it is probed again and the USB rescue gadget still appears
+ *    (the original glue never waited for the core to bind).
  */
 
 #include <linux/clk.h>
 #include <linux/errno.h>
+#include <linux/irq.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
+#include <linux/usb/of.h>
 #include <linux/usb/role.h>
 #include <linux/usb/usb_phy_generic.h>
 
@@ -27,16 +56,27 @@
 #define UTMI_DISABLE_OTG_BITS (UTMI_DISABLE_OTG | (0x3 << 2))
 #define UTMI_PERIPHERAL_MODE  BIT(4)
 
+/* phy_set_mode_ext() submode understood by phy-hichip-usb.c (NZEUS) */
+#define HICHIP_USB_PHY_FORCE_VBUS_VALID	BIT(0)
+
