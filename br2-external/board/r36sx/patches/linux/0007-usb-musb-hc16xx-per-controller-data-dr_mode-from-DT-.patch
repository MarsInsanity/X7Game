-		reg = readl(glue->musb->mregs + USB_O_UTMI);
+		reg = readl(musb->mregs + USB_O_UTMI);
 		reg |= UTMI_DISABLE_PHY | UTMI_DISABLE_OTG_BITS;
-		writel(reg, glue->musb->mregs + USB_O_UTMI);
+		writel(reg, musb->mregs + USB_O_UTMI);
 
-		reg = readl(glue->musb->mregs + USB_O_UTMI);
