diff --git a/Makefile.r36sx b/Makefile.r36sx
new file mode 100644
index 0000000..603eea8
--- /dev/null
+++ b/Makefile.r36sx
@@ -0,0 +1,188 @@
+#########################################################################
+## RetroArch for X7 Game on the R36SX (HiChip E3100, MIPS 74Kc, no GPU)
+##
+## A slim build modelled on Makefile.miyoo: RGUI only, no networking,
+## no OpenGL/shaders/overlays/widgets. Video: the x7fb framebuffer driver
+## (gfx/drivers/x7fb_gfx.c, RGB565 on /dev/fb0). Input: udev (libudev-zero,
+## no udev daemon) reading the "X7 Game Gamepad" virtual pad. Audio: ALSA.
+##
+## Cross-compile: make -f Makefile.r36sx CC=... CXX=...
+#########################################################################
+
+CC    ?= gcc
+CXX   ?= g++
+STRIP ?= strip
+
+PACKAGE_NAME = retroarch
+
+DEBUG ?= 0
+
+HAVE_X7FB = 1
+HAVE_SCREENSHOTS = 1
+HAVE_REWIND = 1
+HAVE_7ZIP = 1
+HAVE_AL = 0
+HAVE_ALSA = 1
+HAVE_TINYALSA = 0
+HAVE_DSP_FILTER = 1
+HAVE_VIDEO_FILTER = 0
+HAVE_STATIC_VIDEO_FILTERS = 0
+HAVE_STATIC_AUDIO_FILTERS = 1
+HAVE_FILTERS_BUILTIN = 1
+HAVE_BUILTINMBEDTLS = 0
+HAVE_BUILTINZLIB = 1
+HAVE_C99 = 1
+HAVE_CC = 1
+HAVE_CC_RESAMPLER = 1
+HAVE_CHD = 1
+HAVE_COMMAND = 0
+HAVE_CXX = 1
+HAVE_DR_MP3 = 1
+HAVE_DYNAMIC = 1
+HAVE_EGL = 0
+HAVE_FREETYPE = 0
+HAVE_GDI = 0
+HAVE_GETADDRINFO = 0
+HAVE_GETOPT_LONG = 1
+HAVE_GLSL = 0
+HAVE_HID = 0
+HAVE_IBXM = 1
+HAVE_IMAGEVIEWER = 0
+HAVE_LANGEXTRA = 0
+HAVE_LIBRETRODB = 1
+HAVE_MENU = 1
+HAVE_MENU_COMMON = 1
+HAVE_GFX_WIDGETS = 0
+HAVE_MMAP = 1
+HAVE_NETWORKING = 0
+HAVE_CHEEVOS = 0
+HAVE_DISCORD = 0
+HAVE_TRANSLATE = 0
+HAVE_ACCESSIBILITY = 0
+HAVE_OPENDINGUX_FBDEV = 0
+HAVE_OPENGL = 0
+HAVE_OPENGL1 = 0
+HAVE_OPENGLES = 0
+HAVE_OPENGLES3 = 0
+HAVE_OPENGL_CORE = 0
+HAVE_OPENSSL = 0
+HAVE_OVERLAY = 0
+HAVE_RBMP = 1
+HAVE_RJPEG = 1
+HAVE_RPILED = 0
+HAVE_RPNG = 1
+HAVE_RUNAHEAD = 0
+HAVE_SDL = 0
+HAVE_SDL2 = 0
+HAVE_SDL_DINGUX = 0
+HAVE_SHADERPIPELINE = 0
+HAVE_STB_FONT = 0
+HAVE_STB_IMAGE = 0
+HAVE_STB_VORBIS = 0
+HAVE_STDIN_CMD = 0
+HAVE_STRCASESTR = 1
+HAVE_THREADS = 1
+HAVE_UDEV = 1
+HAVE_RGUI = 1
+HAVE_MATERIALUI = 0
+HAVE_XMB = 0
+HAVE_OZONE = 0
+HAVE_ZLIB = 1
+HAVE_CONFIGFILE = 1
+HAVE_PATCH = 1
+HAVE_XDELTA = 0
+HAVE_CHEATS = 1
+HAVE_LIBSHAKE = 0
+HAVE_CORE_INFO_CACHE = 1
+HAVE_NEAREST_RESAMPLER = 1
+
+UDEV_CFLAGS := -DHAVE_UDEV
+UDEV_LIBS   := -ludev
+ALSA_LIBS   := -lasound
+
+OS = Linux
+TARGET = retroarch
+
+OBJ :=
+LINK := $(CXX)
+# 74kf2_1: the 74K with its FPU at half the core clock, as on the E3100
+# (74kc would tell GCC there is no FPU and cost every float op as a libcall)
+DEF_FLAGS := -mtune=74kf2_1 -fomit-frame-pointer
+DEF_FLAGS += -ffunction-sections -fdata-sections
+DEF_FLAGS += -I. -Ideps -Ideps/stb -MMD
+DEF_FLAGS += -Wall -Wno-unused-variable
+DEF_FLAGS += -std=gnu99 -D_GNU_SOURCE
+LIBS := -ldl -lrt -pthread
+CFLAGS :=
+CXXFLAGS := -fno-exceptions -fno-rtti -std=c++11 -D__STDC_CONSTANT_MACROS
+ASFLAGS :=
+LDFLAGS := -Wl,--gc-sections
+INCLUDE_DIRS :=
+LIBRARY_DIRS :=
+DEFINES := -DRARCH_INTERNAL -D_FILE_OFFSET_BITS=64 -UHAVE_STATIC_DUMMY
+DEFINES += -DHAVE_C99=1 -DHAVE_CXX=1
+DEFINES += -DHAVE_GETOPT_LONG=1 -DHAVE_STRCASESTR=1 -DHAVE_DYNAMIC=1
+DEFINES += -DHAVE_FILTERS_BUILTIN -DHAVE_ALSA -DHAVE_X7FB
+
+OBJDIR_BASE := obj-unix
+
+ifeq ($(DEBUG), 1)
+   OBJDIR := $(OBJDIR_BASE)/debug
+   DEF_FLAGS += -O0 -g -DDEBUG -D_DEBUG
+else
+   OBJDIR := $(OBJDIR_BASE)/release
+   DEF_FLAGS += -O2 -DNDEBUG
+endif
+
+include Makefile.common
+
+# the X7 Game framebuffer video driver
+OBJ += gfx/drivers/x7fb_gfx.o
+
+DEF_FLAGS += $(INCLUDE_DIRS)
+LDFLAGS += $(CFLAGS) $(CXXFLAGS) $(DEF_FLAGS)
+CFLAGS += $(DEF_FLAGS)
+CXXFLAGS += $(DEF_FLAGS)
+
+HEADERS = $(wildcard */*/*.h) $(wildcard */*.h) $(wildcard *.h)
+
+ifneq ($(V),1)
+        Q := @
+endif
+
+RARCH_OBJ := $(addprefix $(OBJDIR)/,$(OBJ))
+
+all: $(TARGET)
+
+-include $(RARCH_OBJ:.o=.d)
+
+$(TARGET): $(RARCH_OBJ)
+	@$(if $(Q), $(shell echo echo LD $@),)
+	$(Q)$(LINK) -o $@ $(RARCH_OBJ) $(LIBS) $(LDFLAGS) $(LIBRARY_DIRS)
+
+ifeq ($(STRIP_BIN),1)
+	$(STRIP) --strip-unneeded $(TARGET)
+endif
+
+$(OBJDIR)/%.o: %.c
+	@mkdir -p $(dir $@)
+	@$(if $(Q), $(shell echo echo CC $<),)
+	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) $(DEFINES) -c -o $@ $<
+
+$(OBJDIR)/%.o: %.cpp
+	@mkdir -p $(dir $@)
+	@$(if $(Q), $(shell echo echo CXX $<),)
+	$(Q)$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEFINES) -MMD -c -o $@ $<
+
+$(OBJDIR)/%.o: %.S $(HEADERS)
+	@mkdir -p $(dir $@)
+	@$(if $(Q), $(shell echo echo AS $<),)
+	$(Q)$(CC) $(CFLAGS) $(ASFLAGS) $(DEFINES) -c -o $@ $<
+
+clean:
+	@$(if $(Q), echo $@,)
+	$(Q)rm -rf $(OBJDIR_BASE)
+	$(Q)rm -f $(TARGET)
+	$(Q)rm -f *.d
+
+.PHONY: all clean
diff --git a/gfx/drivers/x7fb_gfx.c b/gfx/drivers/x7fb_gfx.c
new file mode 100644
index 0000000..7fe19de
--- /dev/null
+++ b/gfx/drivers/x7fb_gfx.c
@@ -0,0 +1,874 @@
+/*  RetroArch - A frontend for libretro.
+ *  Copyright (C) 2026 - X7 Game
+ *
+ *  x7fb: video driver for plain Linux framebuffers without a GPU, written
+ *  for the X7 Game OS on the R36SX handheld (HiChip E3100, 640x480 panel,
+ *  uncached framebuffer memory). The screen is driven in RGB565; frames are
+ *  scaled with nearest-neighbour lookup tables into a cached line buffer and
+ *  written to the framebuffer with sequential 32-bit stores, once per frame.
+ *  An unchanged screen is not redrawn: duplicate (NULL) frames, the menu
+ *  until RGUI uploads a new texture, and a paused game whose picture and
+ *  on-screen message stay the same. Based on the structure of sdl_rs90_gfx.c.
+ *
+ *  RetroArch is free software: you can redistribute it and/or modify it under the terms
+ *  of the GNU General Public License as published by the Free Software Found-
+ *  ation, either version 3 of the License, or (at your option) any later version.
+ *
+ *  RetroArch is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ *  without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR
+ *  PURPOSE.  See the GNU General Public License for more details.
+ *
+ *  You should have received a copy of the GNU General Public License along with RetroArch.
+ *  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <linux/fb.h>
+#include <linux/kd.h>
+
+#include <retro_inline.h>
+#include <retro_miscellaneous.h>
+#include <string/stdstring.h>
+#include <encodings/utf.h>
+#include <features/features_cpu.h>
+
+#ifdef HAVE_CONFIG_H
+#include "../../config.h"
+#endif
+
+#ifdef HAVE_MENU
+#include "../../menu/menu_driver.h"
+#endif
+
+#include "../../verbosity.h"
+#include "../../input/input_driver.h"
+#include "../../gfx/video_driver.h"
+#include "../../gfx/drivers_font_renderer/bitmap.h"
+#include "../../configuration.h"
+#include "../../retroarch.h"
+
+#define likely(x)   __builtin_expect(!!(x), 1)
+#define unlikely(x) __builtin_expect(!!(x), 0)
+
+#define X7FB_MAX_W      640
+#define X7FB_MAX_H      480
+#define X7FB_NUM_GLYPHS 256
+#define X7FB_FONT_SCALE 2
+/* X7 Game's GMA hardware upscaling (kernel patch 0019), used only when the
+ * system turned it on (x7game.cfg fb_hwscale=1 makes S32x7display create
+ * X7FB_HWSCALE_ON) */
+#define X7FB_SCALE_ATTR "/sys/bus/platform/devices/1883a000.framebuffer/scale"
+#define X7FB_HWSCALE_ON "/run/x7-hwscale"
+
+typedef struct x7fb_video
+{
+   retro_time_t last_frame_time;
+   bitmapfont_lut_t *osd_font;
+   uint8_t *fb;                      /* mmapped framebuffer (uncached) */
+   size_t fb_size;
+   int fd;                           /* /dev/fb0 */
+   int tty;                          /* /dev/tty0, for KD_GRAPHICS */
+   unsigned screen_w, screen_h;      /* 640x480 */
+   unsigned line_length;             /* bytes per screen row */
+   unsigned orig_bpp;
+   /* current output rectangle and source size */
+   unsigned src_w, src_h;
+   unsigned out_x, out_y, out_w, out_h;
+   bool src_rgb32;
+   bool rgb32;                       /* core frames are XRGB8888 */
+   bool scale_integer;
+   bool keep_aspect;
+   bool smooth;                      /* video_smooth: the GMA's filter, else duplicate */
+   /* hardware upscaling: the frame goes 1:1 to the top-left of the buffer
+    * and the GMA stretches it into the output rectangle */
+   int scale_fd;                     /* X7FB_SCALE_ATTR, -1 = not used */
+   bool hw;                          /* the current output is scaled by the GMA */
+   unsigned hw_w, hw_h;              /* the source size given to the GMA (even) */
+   char scale_now[48];               /* the last line written to scale_fd */
+   bool menu_active;
+   bool was_in_menu;
+   bool need_clear;                  /* clear the borders before the next blit */
+   bool menu_dirty;                  /* RGUI uploaded a texture not drawn yet */
+   bool quitting;
+   /* the last game frame written to the screen, to skip redrawing it
+    * while the game is paused */
+   const void *last_frame;
+   unsigned last_w, last_h, last_pitch;
+   uint32_t last_hash;
+   char last_msg[256];               /* the on-screen message now shown */
+   uint16_t xmap[X7FB_MAX_W];        /* output x -> source x */
+   uint16_t ymap[X7FB_MAX_H];        /* output y -> source y */
+   uint32_t line[X7FB_MAX_W / 2];    /* one scaled output row (cached memory) */
+   unsigned menu_w, menu_h;
+   uint16_t menu_texture[X7FB_MAX_W * X7FB_MAX_H];
+} x7fb_video_t;
+
+static INLINE uint16_t x7fb_xrgb8888_to_rgb565(uint32_t p)
+{
+   return (uint16_t)(((p >> 8) & 0xF800) | ((p >> 5) & 0x07E0) | ((p >> 3) & 0x001F));
+}
+
+/* Write one output row (out_w pixels, 2 per 32-bit word) to the screen.
+ * volatile: keep the stores sequential 32-bit stores (no memcpy, which
+ * may prefetch or read on uncached memory). */
+static INLINE void x7fb_put_row(x7fb_video_t *vid, unsigned y,
+      unsigned x, const uint32_t *src, unsigned words)
+{
+   volatile uint32_t *dst = (volatile uint32_t*)(vid->fb +
+         (size_t)y * vid->line_length + x * 2);
+   unsigned i;
+
+   for (i = 0; i < words; i++)
+      dst[i] = src[i];
+}
+
+static void x7fb_clear_screen(x7fb_video_t *vid)
+{
+   unsigned y, i, words = vid->screen_w / 2;
+
+   for (y = 0; y < vid->screen_h; y++)
+   {
+      volatile uint32_t *dst = (volatile uint32_t*)(vid->fb +
+            (size_t)y * vid->line_length);
+      for (i = 0; i < words; i++)
+         dst[i] = 0;
+   }
+}
+
+/* Tell the GMA how to scale ("W H OW OH smooth|sharp", or "off"). A failed
+ * write gives up hardware scaling for the rest of the session. */
+static void x7fb_scale_write(x7fb_video_t *vid, const char *line)
+{
+   if (vid->scale_fd < 0 || string_is_equal(line, vid->scale_now))
+      return;
+   if (pwrite(vid->scale_fd, line, strlen(line), 0) < 0)
+   {
+      RARCH_WARN("[x7fb] Hardware scaling refused (%s): scaling on the CPU.\n", line);
+      close(vid->scale_fd);
+      vid->scale_fd     = -1;
+      vid->hw           = false;
+      vid->scale_now[0] = '\0';
+      return;
+   }
+   strlcpy(vid->scale_now, line, sizeof(vid->scale_now));
+}
+
+/* Work out where (and how big) a src_w x src_h image goes on the screen */
+static void x7fb_set_output(x7fb_video_t *vid,
+      unsigned src_w, unsigned src_h, bool rgb32, bool is_menu)
+{
+   unsigned sw = vid->screen_w, sh = vid->screen_h;
+   unsigned out_w, out_h, i;
+
+   if (src_w == 0 || src_h == 0)
+      return;
+
+   if (is_menu)
+   {
+      /* RGUI renders at 320x240 (or smaller): largest integer scale */
+      unsigned s = MIN(sw / src_w, sh / src_h);
+      if (s == 0)
+         s = 1;
+      out_w = MIN(src_w * s, sw);
+      out_h = MIN(src_h * s, sh);
+   }
+   else if (vid->scale_integer && src_w <= sw && src_h <= sh)
+   {
+      unsigned s = MIN(sw / src_w, sh / src_h);
+      out_w = src_w * s;
+      out_h = src_h * s;
+   }
+   else if (vid->keep_aspect)
+   {
+      float aspect = video_driver_get_aspect_ratio();
+
+      if (aspect <= 0.0f)
+         aspect = (float)src_w / (float)src_h;
+
+      if ((float)sw / (float)sh > aspect)
+      {
+         out_h = sh;
+         out_w = (unsigned)((float)sh * aspect + 0.5f);
+      }
+      else
+      {
+         out_w = sw;
+         out_h = (unsigned)((float)sw / aspect + 0.5f);
+      }
+   }
+   else
+   {
+      out_w = sw;
+      out_h = sh;
+   }
+
+   out_w &= ~1u;                     /* whole 32-bit words per row */
+   if (out_w > sw)
+      out_w = sw;
+   if (out_h > sh)
+      out_h = sh;
+   if (out_w < 2)
+      out_w = 2;
+   if (out_h < 1)
+      out_h = 1;
+
+   vid->src_w     = src_w;
+   vid->src_h     = src_h;
+   vid->src_rgb32 = rgb32;
+   vid->out_w     = out_w;
+   vid->out_h     = out_h;
+   vid->out_x     = ((sw - out_w) / 2) & ~1u;
+   vid->out_y     = (sh - out_h) / 2;
+
+   for (i = 0; i < out_w; i++)
+      vid->xmap[i] = (uint16_t)((i * src_w) / out_w);
+   for (i = 0; i < out_h; i++)
+      vid->ymap[i] = (uint16_t)((i * src_h) / out_h);
+
+   vid->need_clear = true;
+
+   /* Hardware upscaling when the GMA can do this size: even sizes, at
+    * least 16 pixels, upscaling only (an odd last column or row is left
+    * out). The kernel centres the window like this function does. */
+   vid->hw = false;
+   if (vid->scale_fd >= 0)
+   {
+      unsigned hw_w = src_w & ~1u, hw_h = src_h & ~1u;
+      unsigned ow   = out_w & ~1u, oh   = out_h & ~1u;
+
+      if (hw_w >= 16 && hw_h >= 16 && hw_w <= ow && hw_h <= oh)
+      {
+         char line[48];
+
+         snprintf(line, sizeof(line), "%u %u %u %u %s", hw_w, hw_h, ow, oh,
+               vid->smooth ? "smooth" : "sharp");
+         x7fb_scale_write(vid, line);
+         if (vid->scale_fd >= 0)
+         {
+            vid->hw   = true;
+            vid->hw_w = hw_w;
+            vid->hw_h = hw_h;
+         }
+      }
+   }
+   if (!vid->hw)
+      x7fb_scale_write(vid, "off");
+}
+
+/* Scale and write one frame (RGB565 or XRGB8888) */
+static void x7fb_blit(x7fb_video_t *vid, const void *frame,
+      unsigned width, unsigned height, unsigned pitch, bool rgb32)
+{
+   uint16_t *line16 = (uint16_t*)vid->line;
+   unsigned words   = vid->out_w / 2;
+   unsigned j;
+   int last_sy      = -1;
+
+   /* hardware upscaling: the frame 1:1 into the top-left (the rest of the
+    * buffer is not shown, so nothing to clear) */
+   if (vid->hw)
+   {
+      unsigned y, x, hw_words = vid->hw_w / 2;
+
+      vid->need_clear = false;
+      for (y = 0; y < vid->hw_h; y++)
+      {
+         const uint8_t *row = (const uint8_t*)frame + (size_t)y * pitch;
+
+         if (rgb32)
+         {
+            const uint32_t *src = (const uint32_t*)row;
+            for (x = 0; x < vid->hw_w; x++)
+               line16[x] = x7fb_xrgb8888_to_rgb565(src[x]);
+         }
+         else
+            memcpy(line16, row, vid->hw_w * sizeof(uint16_t));
+         x7fb_put_row(vid, y, 0, vid->line, hw_words);
+      }
+      return;
+   }
+
+   if (unlikely(vid->need_clear))
+   {
+      x7fb_clear_screen(vid);
+      vid->need_clear = false;
+   }
+
+   /* fast path: exact 2x of a 16-bit frame (e.g. 320x240 -> 640x480) */
+   if (!rgb32 && vid->out_w == width * 2 && vid->out_h == height * 2)
+   {
+      unsigned y, x;
+      for (y = 0; y < height; y++)
+      {
+         const uint16_t *src = (const uint16_t*)((const uint8_t*)frame + (size_t)y * pitch);
+         for (x = 0; x < width; x++)
+            vid->line[x] = (uint32_t)src[x] | ((uint32_t)src[x] << 16);
+         x7fb_put_row(vid, vid->out_y + 2 * y,     vid->out_x, vid->line, words);
+         x7fb_put_row(vid, vid->out_y + 2 * y + 1, vid->out_x, vid->line, words);
+      }
+      return;
+   }
+
+   for (j = 0; j < vid->out_h; j++)
+   {
+      unsigned sy = vid->ymap[j];
+
+      if ((int)sy != last_sy)
+      {
+         unsigned i;
+         if (rgb32)
+         {
+            const uint32_t *src = (const uint32_t*)((const uint8_t*)frame + (size_t)sy * pitch);
+            for (i = 0; i < vid->out_w; i++)
+               line16[i] = x7fb_xrgb8888_to_rgb565(src[vid->xmap[i]]);
+         }
+         else
+         {
+            const uint16_t *src = (const uint16_t*)((const uint8_t*)frame + (size_t)sy * pitch);
+            for (i = 0; i < vid->out_w; i++)
+               line16[i] = src[vid->xmap[i]];
+         }
+         last_sy = (int)sy;
+      }
+      x7fb_put_row(vid, vid->out_y + j, vid->out_x, vid->line, words);
+   }
+}
+
+/* A cheap fingerprint of a frame: 64 pixels, each on a different row and
+ * column ((k * 23) & 63 visits every column slot once). It reads the core's
+ * frame in cached memory, never the screen. */
+static uint32_t x7fb_frame_hash(const void *frame, unsigned width,
+      unsigned height, unsigned pitch, bool rgb32)
+{
+   uint32_t hash = 2166136261u;      /* FNV-1a */
+   unsigned k;
+
+   if (width == 0 || height == 0)
+      return 0;
+
+   for (k = 0; k < 64; k++)
+   {
+      unsigned x       = (((k * 23) & 63) * width) / 64;
+      unsigned y       = (k * height) / 64;
+      const uint8_t *p = (const uint8_t*)frame + (size_t)y * pitch;
+      uint32_t px      = rgb32 ? ((const uint32_t*)p)[x]
+                               : ((const uint16_t*)p)[x];
+      hash = (hash ^ px) * 16777619u;
+   }
+   return hash;
+}
+
+/* one font pixel = a fs x fs block */
+static INLINE void x7fb_font_px(x7fb_video_t *vid, unsigned x, unsigned y,
+      unsigned fs, uint16_t colour)
+{
+   unsigned k, l;
+
+   for (k = 0; k < fs; k++)
+   {
+      volatile uint16_t *p = (volatile uint16_t*)(vid->fb +
+            (size_t)(y + k) * vid->line_length) + x;
+      for (l = 0; l < fs; l++)
+         p[l] = colour;
+   }
+}
+
+/* On-screen message (fps, notifications): 5x10 bitmap font, doubled,
+ * white with a black shadow, drawn inside the bottom of the image (the
+ * next frame overwrites it). Never reads the framebuffer (uncached). */
+static void x7fb_blit_text(x7fb_video_t *vid, const char *str)
+{
+   bool **font_lut = vid->osd_font->lut;
+   /* with hardware upscaling the text goes into the source picture at 1x
+    * (the GMA enlarges it with the frame); else onto the screen at 2x */
+   unsigned fs     = vid->hw ? 1 : X7FB_FONT_SCALE;
+   unsigned ox     = vid->hw ? 0 : vid->out_x;
+   unsigned oy     = vid->hw ? 0 : vid->out_y;
+   unsigned ow     = vid->hw ? vid->hw_w : vid->out_w;
+   unsigned oh     = vid->hw ? vid->hw_h : vid->out_h;
+   unsigned char_w = FONT_WIDTH_STRIDE * fs;
+   unsigned x      = ox + 4 * fs;
+   unsigned y;
+
+   if (oh < (FONT_HEIGHT + 4) * fs + 2)
+      return;
+   y = oy + oh - (FONT_HEIGHT + 4) * fs;
+
+   while (!string_is_empty(str))
+   {
+      uint32_t symbol;
+      bool *glyph;
+      unsigned gx, gy, pass;
+
+      if (x + char_w + 1 >= ox + ow)
+         return;
+      if (*str == ' ')
+      {
+         str++;
+         x += char_w;
+         continue;
+      }
+      symbol = utf8_walk(&str);
+      if (symbol == 339)
+         symbol = 156;
+      if (symbol == 338)
+         symbol = 140;
+      if (symbol >= X7FB_NUM_GLYPHS)
+         continue;
+      glyph = font_lut[symbol];
+
+      for (pass = 0; pass < 2; pass++)       /* 0 = shadow, 1 = text */
+         for (gy = 0; gy < FONT_HEIGHT; gy++)
+            for (gx = 0; gx < FONT_WIDTH; gx++)
+               if (glyph[gx + gy * FONT_WIDTH])
+                  x7fb_font_px(vid,
+                        x + gx * fs + (pass ? 0 : 1),
+                        y + gy * fs + (pass ? 0 : 1),
+                        fs, pass ? 0xFFFF : 0x0000);
+      x += char_w;
+   }
+}
+
+static void x7fb_gfx_free(void *data)
+{
+   x7fb_video_t *vid = (x7fb_video_t*)data;
+
+   if (!vid)
+      return;
+
+   /* the text console needs the 1:1 picture back */
+   if (vid->scale_fd >= 0)
+   {
+      x7fb_scale_write(vid, "off");
+      if (vid->scale_fd >= 0)
+         close(vid->scale_fd);
+   }
+
+   if (vid->fb && vid->fb != MAP_FAILED)
+   {
+      x7fb_clear_screen(vid);
+      munmap(vid->fb, vid->fb_size);
+   }
+   if (vid->fd >= 0)
+   {
+      struct fb_var_screeninfo var;
+      if (vid->orig_bpp && ioctl(vid->fd, FBIOGET_VSCREENINFO, &var) == 0 &&
+            var.bits_per_pixel != vid->orig_bpp)
+      {
+         var.bits_per_pixel = vid->orig_bpp;
+         ioctl(vid->fd, FBIOPUT_VSCREENINFO, &var);
+      }
+      close(vid->fd);
+   }
+   if (vid->tty >= 0)
+   {
+      ioctl(vid->tty, KDSETMODE, KD_TEXT);
+      close(vid->tty);
+   }
+   if (vid->osd_font)
+      bitmapfont_free_lut(vid->osd_font);
+
+   free(vid);
+}
+
+static void x7fb_input_driver_init(
+      const char *input_drv_name, const char *joypad_drv_name,
+      input_driver_t **input, void **input_data)
+{
+   if (!input || !input_data)
+      return;
+
+   *input      = NULL;
+   *input_data = NULL;
+
+   if (string_is_empty(input_drv_name))
+      return;
+
+#if defined(HAVE_UDEV)
+   if (string_is_equal(input_drv_name, "udev"))
+   {
+      *input_data = input_driver_init_wrap(&input_udev, joypad_drv_name);
+      if (*input_data)
+         *input = &input_udev;
+      return;
+   }
+#endif
+
+#if defined(__linux__)
+   if (string_is_equal(input_drv_name, "linuxraw"))
+   {
+      *input_data = input_driver_init_wrap(&input_linuxraw, joypad_drv_name);
+      if (*input_data)
+         *input = &input_linuxraw;
+      return;
+   }
+#endif
+}
+
+static void *x7fb_gfx_init(const video_info_t *video,
+      input_driver_t **input, void **input_data)
+{
+   struct fb_var_screeninfo var;
+   struct fb_fix_screeninfo fix;
+   settings_t *settings = config_get_ptr();
+   x7fb_video_t *vid    = (x7fb_video_t*)calloc(1, sizeof(*vid));
+
+   if (!vid)
+      return NULL;
+
+   vid->fd       = -1;
+   vid->tty      = -1;
+   vid->scale_fd = -1;
+
+   vid->fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+   if (vid->fd < 0 || ioctl(vid->fd, FBIOGET_VSCREENINFO, &var) < 0)
+   {
+      RARCH_ERR("[x7fb] Cannot open /dev/fb0.\n");
+      goto error;
+   }
+   vid->orig_bpp = var.bits_per_pixel;
+
+   /* Keep the text console from drawing over the picture. This must come
+    * before the depth change: while the console is in KD_TEXT, fbcon takes
+    * a mode change as the console's own mode, redraws itself in it, and
+    * puts that mode back whenever KD_TEXT returns, which would leave the
+    * console in 16-bit after the game. Switched first, fbcon keeps its
+    * 32-bit record and restores it at KD_TEXT, in x7fb_gfx_free or, after
+    * a crash, when the game list sets KD_TEXT again. */
+   vid->tty = open("/dev/tty0", O_RDWR | O_CLOEXEC);
+   if (vid->tty >= 0)
+      ioctl(vid->tty, KDSETMODE, KD_GRAPHICS);
+
+   /* the whole screen runs in RGB565: half the bytes to push per frame */
+   if (var.bits_per_pixel != 16)
+   {
+      var.bits_per_pixel = 16;
+      var.activate       = FB_ACTIVATE_NOW;
+      if (ioctl(vid->fd, FBIOPUT_VSCREENINFO, &var) < 0 ||
+            ioctl(vid->fd, FBIOGET_VSCREENINFO, &var) < 0 ||
+            var.bits_per_pixel != 16)
+      {
+         RARCH_ERR("[x7fb] The framebuffer has no 16-bit mode.\n");
+         goto error;
+      }
+   }
+   if (ioctl(vid->fd, FBIOGET_FSCREENINFO, &fix) < 0)
+      goto error;
+
+   vid->screen_w    = MIN(var.xres, X7FB_MAX_W);
+   vid->screen_h    = MIN(var.yres, X7FB_MAX_H);
+   vid->line_length = fix.line_length;
+   vid->fb_size     = fix.smem_len;
+   vid->fb          = (uint8_t*)mmap(NULL, vid->fb_size,
+         PROT_READ | PROT_WRITE, MAP_SHARED, vid->fd, 0);
+   if (vid->fb == MAP_FAILED)
+   {
+      vid->fb = NULL;
+      RARCH_ERR("[x7fb] Cannot map the framebuffer.\n");
+      goto error;
+   }
+
+   /* fbcon no longer redraws the screen at the depth change: clear the
+    * console picture left behind, which would show as noise in RGB565
+    * until the first frame (loading the content can take seconds) */
+   x7fb_clear_screen(vid);
+
+   vid->rgb32         = video->rgb32;
+   vid->scale_integer = settings->bools.video_scale_integer;
+   /* video_force_aspect: keep the aspect ratio (else stretch) */
+   vid->keep_aspect   = settings->bools.video_force_aspect;
+   vid->smooth        = settings->bools.video_smooth;
+   if (access(X7FB_HWSCALE_ON, F_OK) == 0)
+   {
+      vid->scale_fd = open(X7FB_SCALE_ATTR, O_WRONLY | O_CLOEXEC);
+      RARCH_LOG("[x7fb] Hardware upscaling %s.\n",
+            vid->scale_fd >= 0 ? "on" : "not available (old kernel?)");
+   }
+   vid->menu_w        = 320;
+   vid->menu_h        = 240;
+
+   x7fb_input_driver_init(settings->arrays.input_driver,
+         settings->arrays.input_joypad_driver, input, input_data);
+
+   vid->osd_font = bitmapfont_get_lut();
+   if (!vid->osd_font || vid->osd_font->glyph_max < (X7FB_NUM_GLYPHS - 1))
+   {
+      RARCH_ERR("[x7fb] Cannot initialise the OSD font.\n");
+      goto error;
+   }
+
+   x7fb_set_output(vid, vid->screen_w / 2, vid->screen_h / 2, false, false);
+   RARCH_LOG("[x7fb] %ux%u RGB565 framebuffer, line %u bytes.\n",
+         vid->screen_w, vid->screen_h, vid->line_length);
+   return vid;
+
+error:
+   x7fb_gfx_free(vid);
+   return NULL;
+}
+
+static bool x7fb_gfx_frame(void *data, const void *frame,
+      unsigned width, unsigned height, uint64_t frame_count,
+      unsigned pitch, const char *msg, video_frame_info_t *video_info)
+{
+   x7fb_video_t *vid  = (x7fb_video_t*)data;
+   bool menu_is_alive = false;
+   bool drawn         = false;
+   bool msg_changed;
+
+   if (unlikely(!vid))
+      return true;
+
+#ifdef HAVE_MENU
+   menu_is_alive = (video_info->menu_st_flags & MENU_ST_FLAG_ALIVE) ? true : false;
+#endif
+
+   /* Fast-forward with RetroArch's own frame skipping turned off: the
+    * panel shows at most 60 frames per second, so pushing more is wasted
+    * work on uncached memory. With fastforward_frameskip on (the default)
+    * RetroArch already drops the extra frames, and a second limit here
+    * would drop some of the ones it keeps. 15 ms leaves room for jitter
+    * around the 16.7 ms frame time. The menu is always drawn. */
+   if (unlikely(video_info->input_driver_nonblock_state &&
+         !video_info->fastforward_frameskip && !menu_is_alive))
+   {
+      retro_time_t now = cpu_features_get_time_usec();
+      if (now - vid->last_frame_time < 15000)
+         return true;
+      vid->last_frame_time = now;
+   }
+
+#ifdef HAVE_MENU
+   menu_driver_frame(menu_is_alive, video_info);
+#endif
+
+   /* RetroArch passes "" when there is no message. The text is drawn over
+    * the picture, so a message that appears, changes or goes away needs a
+    * full redraw to erase the old text. */
+   if (!msg)
+      msg = "";
+   msg_changed = strncmp(msg, vid->last_msg, sizeof(vid->last_msg) - 1) != 0;
+
+   if (likely(!vid->menu_active))
+   {
+      if (unlikely(vid->was_in_menu ||
+            width != vid->src_w || height != vid->src_h ||
+            vid->rgb32 != vid->src_rgb32))
+         x7fb_set_output(vid, width, height, vid->rgb32, false);
+      vid->was_in_menu = false;
+
+      /* NULL = the core repeated the previous frame: nothing to do */
+      if (likely(frame))
+      {
+         /* While the game is paused, RetroArch hands over the same cached
+          * frame 60 times a second: draw it once. The same pointer and size
+          * are not enough on their own, because cores that draw into one
+          * static buffer keep the pointer when frame advance changes the
+          * picture, so the sampled pixels must match too. The hash is only
+          * taken while paused (0 = not taken), so the first paused frame
+          * is always drawn. */
+         uint32_t hash = 0;
+         bool skip     = false;
+
+         if (unlikely(video_info->runloop_is_paused))
+         {
+            hash = x7fb_frame_hash(frame, width, height, pitch, vid->rgb32);
+            skip = !vid->need_clear && !msg_changed &&
+                  frame  == vid->last_frame &&
+                  width  == vid->last_w     &&
+                  height == vid->last_h     &&
+                  pitch  == vid->last_pitch &&
+                  hash   == vid->last_hash;
+         }
+
+         if (likely(!skip))
+         {
+            x7fb_blit(vid, frame, width, height, pitch, vid->rgb32);
+            vid->last_frame = frame;
+            vid->last_w     = width;
+            vid->last_h     = height;
+            vid->last_pitch = pitch;
+            vid->last_hash  = hash;
+            drawn           = true;
+         }
+      }
+   }
+   else
+   {
+      if (!vid->was_in_menu ||
+            vid->src_w != vid->menu_w || vid->src_h != vid->menu_h)
+      {
+         x7fb_set_output(vid, vid->menu_w, vid->menu_h, false, true);
+         vid->was_in_menu = true;
+      }
+      /* RGUI uploads a new texture only when the menu changed (it is drawn
+       * on the next call): redraw only then, after an output change
+       * (need_clear, also set on entering the menu) or for a new message */
+      if (vid->menu_dirty || vid->need_clear || msg_changed)
+      {
+         x7fb_blit(vid, vid->menu_texture, vid->menu_w, vid->menu_h,
+               vid->menu_w * sizeof(uint16_t), false);
+         vid->menu_dirty = false;
+         vid->last_frame = NULL;     /* the game frame is gone from the screen */
+         drawn           = true;
+      }
+   }
+
+   /* the text stays on the screen until the picture under it is redrawn */
+   if (drawn || msg_changed)
+   {
+      if (*msg)
+         x7fb_blit_text(vid, msg);
+      strlcpy(vid->last_msg, msg, sizeof(vid->last_msg));
+   }
+
+   return true;
+}
+
+static void x7fb_set_texture_enable(void *data, bool state, bool full_screen)
+{
+   x7fb_video_t *vid = (x7fb_video_t*)data;
+   if (vid)
+      vid->menu_active = state;
+}
+
+static void x7fb_set_texture_frame(void *data, const void *frame, bool rgb32,
+      unsigned width, unsigned height, float alpha)
+{
+   x7fb_video_t *vid = (x7fb_video_t*)data;
+
+   /* RGUI hands over RGB565 (see rgui.c, argb32_to_pixel_platform_format) */
+   if (unlikely(!vid || !frame || rgb32 || width == 0 || height == 0 ||
+         width > X7FB_MAX_W || height > X7FB_MAX_H))
+      return;
+
+   memcpy(vid->menu_texture, frame, width * height * sizeof(uint16_t));
+   vid->menu_w     = width;
+   vid->menu_h     = height;
+   vid->menu_dirty = true;
+}
