config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	select BR2_PACKAGE_ALSA_LIB_MIXER
	select BR2_PACKAGE_ALSA_LIB_SEQ # midi/drivers/alsa_midi.c
	select BR2_PACKAGE_LIBUDEV_ZERO
	help
	  RetroArch, the libretro frontend, in a slim build for the
	  R36SX (Makefile.r36sx): RGUI menu, the x7fb framebuffer video
	  driver (RGB565 on /dev/fb0), udev input, ALSA audio; no
	  networking, OpenGL, shaders or overlays.

	  https://www.retroarch.com
