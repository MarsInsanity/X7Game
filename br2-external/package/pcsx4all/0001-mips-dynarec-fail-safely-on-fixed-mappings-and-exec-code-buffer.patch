mips dynarec: fail safely on fixed mappings, executable code buffer

X7 Game (R36SX, MIPS 74Kc):
- PS1 RAM, its mirrors and the block tables are mapped at fixed addresses
  (0x10000000, 0x20000000). Use MAP_FIXED_NOREPLACE (and check the address)
  instead of MAP_FIXED, which silently replaces whatever is mapped there,
  and treat a failed mirror as a failure (the dynarec relies on all four
  mirrors; before, a failed mirror still reported success). On failure the
  existing fallback (malloc, slower code) is used.
- SHMEM_MIRRORING: close the shared memory fd once mapped (it was leaked).
- The code buffer is a static array in .bss, mapped without PROT_EXEC: ask
  for PROT_EXEC explicitly, in case the CPU/kernel enforce execute-inhibit.
diff --git a/src/recompiler/mips/mem_mapping.c b/src/recompiler/mips/mem_mapping.c
index a9d8c3e..1256112 100644
--- a/src/recompiler/mips/mem_mapping.c
+++ b/src/recompiler/mips/mem_mapping.c
@@ -40,6 +40,26 @@
 #ifdef SHMEM_MIRRORING
 #include <sys/shm.h>   // For Posix shared mem
 #endif
+#include <errno.h>
+
+/* Fixed-address mapping that fails instead of silently replacing whatever
+ *  is already mapped there (plain MAP_FIXED would). On failure the callers
+ *  fall back to malloc() and slower code. MAP_FIXED_NOREPLACE: Linux 4.17+;
+ *  an older kernel takes it as a hint, so the address is checked too. */
+#ifndef MAP_FIXED_NOREPLACE
+#define MAP_FIXED_NOREPLACE 0x100000
+#endif
+static void* map_fixed(void* addr, size_t len, int flags, int fd)
+{
+	void* p = mmap(addr, len, PROT_READ|PROT_WRITE,
+			flags|MAP_FIXED_NOREPLACE, fd, 0);
+	if (p != MAP_FAILED && p != addr) {
+		munmap(p, len);
+		errno = EEXIST;
+		p = MAP_FAILED;
+	}
+	return p;
+}
 
