+	// The code buffer lives in .bss, which the kernel maps without execute
+	//  permission: that only matters on CPUs with execute-inhibit (MIPS
+	//  RIXI), but then every block would fault. Ask for it explicitly.
+	{
+		uintptr_t pg = (uintptr_t)sysconf(_SC_PAGESIZE);
+		uintptr_t start = (uintptr_t)recMemBase & ~(pg - 1);
+		uintptr_t end = ((uintptr_t)recMemBase + RECMEM_SIZE + pg - 1) & ~(pg - 1);
+		if (mprotect((void*)start, end - start, PROT_READ|PROT_WRITE|PROT_EXEC) < 0)
+			perror("mipsrec: mprotect(PROT_EXEC) of the code buffer");
+	}
