+		} else if (!strcmp(line, "VSyncWA")) {
+			sscanf(arg, "%d", &value);
+			Config.VSyncWA = value;
+		} else if (!strcmp(line, "Cpu")) {
+			sscanf(arg, "%d", &value);
+			Config.Cpu = value;
+		} else if (!strcmp(line, "PsxType")) {
+			sscanf(arg, "%d", &value);
