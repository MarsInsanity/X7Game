+++ b/src/port/r36sx/port.c
@@ -0,0 +1,1483 @@
+/*
+ * PCSX4ALL port for X7 Game on the R36SX (HiChip E3100: one MIPS 74Kc core
+ * at 900 MHz, no GPU, 640x480 screen). Based on src/port/sdl/port.c, with
+ * SDL replaced by x7_hw.c (fbdev, evdev, signals) and vout_x7.c (scaling);
+ * audio is the spu_pcsxrearmed ALSA driver.
+ *
+ *   pcsx4all [options] -iso <disc image>     (or just: pcsx4all <disc image>)
+ *
+ * Buttons: B = Cross, A = Circle, X = Triangle, Y = Square, L1/R1/L2/R2,
+ * SELECT, START, D-pad. FN opens the menu (D-pad, A = confirm, B = back,
+ * FN = back to the game; "Quit" returns to the game list).
+ *
+ * Paths (directories are created as needed):
+ *   BIOS            $PCSX4ALL_BIOS_DIR   (default /share/bios)
+ *   memory cards    $PCSX4ALL_SAVE_DIR/memcards (default /share/saves/psx)
+ *   save states     $PCSX4ALL_SAVE_DIR/states
+ *   settings        $PCSX4ALL_CONFIG_DIR/pcsx4all.cfg (/share/system/pcsx4all)
+ *   cheats, PPF     $PCSX4ALL_CONFIG_DIR/cheats, .../patches
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <dirent.h>
+#include <errno.h>
+#include <unistd.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include "port.h"
+#include "r3000a.h"
+#include "plugins.h"
+#include "plugin_lib.h"
+#include "perfmon.h"
+#include "cheat.h"
+#include "cdrom_hacks.h"
+#include "sio.h"
+#include "x7_hw.h"
+
+#ifdef SPU_PCSXREARMED
+#include "spu/spu_pcsxrearmed/spu_config.h"		// To set spu-specific configuration
+#endif
+
+// New gpulib from Notaz's PCSX Rearmed handles duties common to GPU plugins
+#ifdef USE_GPULIB
+#include "gpu/gpulib/gpu.h"
+#endif
+
+#ifdef GPU_UNAI
+#include "gpu/gpu_unai/gpu.h"
+#endif
+
+enum {
+	DKEY_SELECT = 0,
+	DKEY_L3,
+	DKEY_R3,
+	DKEY_START,
+	DKEY_UP,
+	DKEY_RIGHT,
+	DKEY_DOWN,
+	DKEY_LEFT,
+	DKEY_L2,
+	DKEY_R2,
+	DKEY_L1,
+	DKEY_R1,
+	DKEY_TRIANGLE,
+	DKEY_CIRCLE,
+	DKEY_CROSS,
+	DKEY_SQUARE,
+
+	DKEY_TOTAL
+};
+
+/* frontend.c's menu key bits */
+enum {
+	MKEY_UP = 0x1, MKEY_LEFT = 0x4, MKEY_DOWN = 0x10, MKEY_RIGHT = 0x40,
+	MKEY_START = 1 << 8, MKEY_SELECT = 1 << 9, MKEY_L = 1 << 10, MKEY_R = 1 << 11,
+	MKEY_A = 1 << 12, MKEY_B = 1 << 13, MKEY_X = 1 << 14, MKEY_Y = 1 << 15,
+};
+
+/* the menu canvas (cached RAM), shown doubled by video_flip() */
+static uint16_t menu_canvas[320 * 240] __attribute__((aligned(32)));
+unsigned short *SCREEN = menu_canvas;
+int SCREEN_WIDTH = 320, SCREEN_HEIGHT = 240;
+
+static uint_fast8_t pcsx4all_initted = false;
+static uint_fast8_t emu_running = false;
+static uint_fast8_t hle_forced = false;  /* HLE only because no BIOS was found */
+void config_load();
+void config_save();
+void update_window_size(int w, int h, uint_fast8_t ntsc_fix);
+
+static void pcsx4all_exit(void)
+{
+	if (pcsx4all_initted == true) {
+		// Flush, sync and close memory card files opened for writing
+		sioSyncMcds();
+		// unload cheats
+		cheat_unload();
+	}
+
+	// Store config to file
+	config_save();
+
+	// The screen and the console go back to the game list first, in case
+	//  the plugin shutdown below goes wrong
+	x7_video_restore();
+	x7_input_shutdown();
+
+	if (pcsx4all_initted == true) {
+		ReleasePlugins();
+		psxShutdown();
+	}
+	fflush(stdout);
+}
+
+/* exit cleanly (memory cards, settings, screen: see pcsx4all_exit()) */
+static void quit_now(void)
+{
+	printf("Quit requested, exiting.\n");
+	exit(0);
+}
+
+/* SIGTERM & co (power-off): exit, but let a game that is writing a memory
+ * card finish its save first, for up to 2 s (the signal handler's watchdog
+ * forces the exit after 4 s, X7 Game's shutdown waits 5 s) */
+#define QUIT_MCD_GRACE_MS 2000
+
+static void check_quit(void)
+{
+	static unsigned int quit_since = 0;
+	unsigned int now;
+
+	if (!x7_quit_requested())
+		return;
+	now = x7_ticks_ms() | 1;
+	if (!quit_since) {
+		quit_since = now;
+		if (sioMcdBusy())
+			printf("Quit requested while a memory card is being written: "
+			       "waiting for the save to finish\n");
+	}
+	if (!sioMcdBusy() || (unsigned int)(now - quit_since) >= QUIT_MCD_GRACE_MS)
+		quit_now();
+}
+
+static char McdPath1[MAXPATHLEN] = "";
+static char McdPath2[MAXPATHLEN] = "";
+static char BiosFile[MAXPATHLEN] = "";
+
+static char homedir[MAXPATHLEN];
+static char savedir[MAXPATHLEN];
+static char memcardsdir[MAXPATHLEN];
+static char biosdir[MAXPATHLEN];
+static char patchesdir[MAXPATHLEN];
+char sstatesdir[MAXPATHLEN];
+char cheatsdir[MAXPATHLEN];
+
+/* mkdir -p */
+static void make_dirs(const char *path)
+{
+	char tmp[MAXPATHLEN];
+	char *p;
+
+	snprintf(tmp, sizeof(tmp), "%s", path);
+	for (p = tmp + 1; *p; p++) {
+		if (*p == '/') {
+			*p = '\0';
+			mkdir(tmp, 0755);
+			*p = '/';
+		}
+	}
+	if (mkdir(tmp, 0755) < 0 && errno != EEXIST)
+		printf("Warning: cannot create directory %s: %s\n", tmp, strerror(errno));
+}
+
+static const char *env_or(const char *name, const char *def)
+{
+	const char *v = getenv(name);
+	return (v && *v) ? v : def;
+}
+
+static void setup_paths()
+{
+	snprintf(homedir, sizeof(homedir), "%s",
+		 env_or("PCSX4ALL_CONFIG_DIR", "/share/system/pcsx4all"));
+	snprintf(savedir, sizeof(savedir), "%s",
+		 env_or("PCSX4ALL_SAVE_DIR", "/share/saves/psx"));
+	snprintf(biosdir, sizeof(biosdir), "%s",
+		 env_or("PCSX4ALL_BIOS_DIR", "/share/bios"));
+
+	snprintf(sstatesdir, sizeof(sstatesdir), "%s/states", savedir);
+	snprintf(memcardsdir, sizeof(memcardsdir), "%s/memcards", savedir);
+	snprintf(patchesdir, sizeof(patchesdir), "%s/patches", homedir);
+	snprintf(cheatsdir, sizeof(cheatsdir), "%s/cheats", homedir);
+
+	make_dirs(homedir);
+	make_dirs(sstatesdir);
+	make_dirs(memcardsdir);
+	make_dirs(biosdir);
+	make_dirs(patchesdir);
+	make_dirs(cheatsdir);
+}
+
+static int dir_exists(const char *path)
+{
+	struct stat st;
+	return path && *path && stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static void default_lastdir(void)
+{
+	const char *home = getenv("HOME");
+
+	if (dir_exists("/share/roms/psx"))
+		strcpy(Config.LastDir, "/share/roms/psx");
+	else if (dir_exists("/share/roms"))
+		strcpy(Config.LastDir, "/share/roms");
+	else if (dir_exists("/share"))
+		strcpy(Config.LastDir, "/share");
+	else if (dir_exists(home))
+		snprintf(Config.LastDir, sizeof(Config.LastDir), "%s", home);
+	else
+		strcpy(Config.LastDir, "/");
+}
+
+void probe_lastdir()
+{
+	if (!dir_exists(Config.LastDir))
+		default_lastdir();
+}
+
+/* Case-insensitive look-up of 'name' in the BIOS directory; a file of at
+ * least 512 KiB counts. */
+static int bios_present(const char *name)
+{
+	DIR *d;
+	struct dirent *e;
+	int found = 0;
+
+	if (string_is_empty(name) || !(d = opendir(Config.BiosDir)))
+		return 0;
+	while (!found && (e = readdir(d))) {
+		if (!strcasecmp(e->d_name, name)) {
+			char path[MAXPATHLEN * 2];
+			struct stat st;
+			snprintf(path, sizeof(path), "%s/%s", Config.BiosDir, e->d_name);
+			found = stat(path, &st) == 0 && S_ISREG(st.st_mode) &&
+				st.st_size >= 0x80000;
+		}
+	}
+	closedir(d);
+	return found;
+}
+
+/* BIOS files tried in this order when the configured one is missing */
+static const char *const known_bios[] = {
+	"scph1001.bin", "scph5501.bin", "scph7001.bin", "scph7501.bin",
+	"scph101.bin", "scph1000.bin", "scph3000.bin", "scph3500.bin",
+	"scph5000.bin", "scph5500.bin", "scph7000.bin", "scph7500.bin",
+	"scph9000.bin", "scph100.bin", "scph5502.bin", "scph5552.bin",
+	"scph7002.bin", "scph7502.bin", "scph9002.bin", "scph102.bin",
+	"scph1002.bin", "scph5002.bin", "psxonpsp660.bin", "ps1_rom.bin",
+	NULL
+};
+
+/* Real BIOS when one is in the BIOS directory, else the HLE BIOS for this
+ * run (without changing the saved setting). */
+static void choose_bios(void)
+{
+	int i;
+
+	hle_forced = false;
+	if (Config.HLE)
+		return;
+	if (bios_present(Config.Bios))
+		return;
+	for (i = 0; known_bios[i]; i++) {
+		if (bios_present(known_bios[i])) {
+			printf("BIOS %s not found, using %s\n", Config.Bios, known_bios[i]);
+			strcpy(Config.Bios, known_bios[i]);
+			return;
+		}
+	}
+	printf("No BIOS in %s (looked for %s, scph5501.bin, scph7001.bin, ...): "
+	       "using the HLE BIOS.\n", Config.BiosDir, Config.Bios);
+	Config.HLE = 1;
+	hle_forced = true;
+}
+
+#ifdef PSXREC
+extern uint32_t cycle_multiplier; // in mips/recompiler.cpp
+#endif
+
+static void config_path(char *buf, size_t size)
+{
+	snprintf(buf, size, "%s/pcsx4all.cfg", homedir);
+}
+
+void config_load()
+{
+	FILE *f;
+	char config[MAXPATHLEN + 16];
+	char line[MAXPATHLEN + 8 + 1];
+	int lineNum = 0;
+
+	config_path(config, sizeof(config));
+	f = fopen(config, "r");
+
+	if (f == NULL) {
+		printf("No config file \"%s\" yet, using defaults.\n", config);
+		return;
+	}
+
+	while (fgets(line, sizeof(line), f)) {
+		char *arg = strchr(line, ' ');
+		int value;
+
+		++lineNum;
+
+		if (!arg) {
+			continue;
+		}
+
+		*arg = '\0';
+		arg++;
+
+		if (lineNum == 1) {
+			if (!strcmp(line, "CONFIG_VERSION")) {
+				sscanf(arg, "%d", &value);
+				if (value == CONFIG_VERSION) {
+					continue;
+				} else {
+					printf("Incompatible config version for \"%s\"."
+					       "Required: %d. Found: %d. Ignoring.\n",
+					       config, CONFIG_VERSION, value);
+					break;
+				}
+			}
+
+			printf("Incompatible config format for \"%s\"."
+			       "Ignoring.\n", config);
+			break;
+		}
+
+		if (!strcmp(line, "Xa")) {
+			sscanf(arg, "%d", &value);
+			Config.Xa = value;
+		} else if (!strcmp(line, "Mdec")) {
+			sscanf(arg, "%d", &value);
+			Config.Mdec = value;
+		} else if (!strcmp(line, "PsxAuto")) {
+			sscanf(arg, "%d", &value);
+			Config.PsxAuto = value;
+		} else if (!strcmp(line, "Cdda")) {
+			sscanf(arg, "%d", &value);
+			Config.Cdda = value;
+		} else if (!strcmp(line, "HLE")) {
+			sscanf(arg, "%d", &value);
+			Config.HLE = value;
+		} else if (!strcmp(line, "SlowBoot")) {
+			sscanf(arg, "%d", &value);
+			Config.SlowBoot = value;
+		} else if (!strcmp(line, "AnalogArrow")) {
+			sscanf(arg, "%d", &value);
+			Config.AnalogArrow = value;
+		} else if (!strcmp(line, "Analog_Mode")) {
+			sscanf(arg, "%d", &value);
