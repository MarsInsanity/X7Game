+/* ------------------------------------------------------------- buttons */
+
+static uint16_t pad1 = 0xFFFF;
+static uint16_t pad2 = 0xFFFF;
+
+/* buttons held when switching between game and menu are ignored until
+ * released, so the button that closed the menu does not reach the game */
+static uint32_t game_suppress = 0;
+static uint32_t menu_suppress = 0;
+static uint32_t prev_held = 0;
+
+struct ps1_controller player_controller[2];
+
+void Set_Controller_Mode()
+{
+	switch (Config.AnalogMode) {
+		/* Digital. Required for some games. */
+	default: player_controller[0].id = 0x41;
+		player_controller[0].pad_mode = 0;
+		player_controller[0].pad_controllertype = 0;
+		break;
+		/* DualAnalog. Some games might misbehave with Dualshock like Descent so this is for those */
+	case 1: player_controller[0].id = 0x53;
+		player_controller[0].pad_mode = 1;
+		player_controller[0].pad_controllertype = 1;
+		break;
+		/* DualShock, required for Ape Escape. */
+	case 2: player_controller[0].id = 0x73;
+		player_controller[0].pad_mode = 1;
+		player_controller[0].pad_controllertype = 1;
+		break;
+	}
+}
+
+static void pad_init(void)
+{
+	player_controller[0].id = 0x41;
+	player_controller[0].pad_mode = 0;
+	player_controller[0].pad_controllertype = 0;
+
+	player_controller[0].joy_left_ax0 = 127;
+	player_controller[0].joy_left_ax1 = 127;
+	player_controller[0].joy_right_ax0 = 127;
+	player_controller[0].joy_right_ax1 = 127;
+
+	player_controller[0].Vib[0] = 0;
+	player_controller[0].Vib[1] = 0;
+	player_controller[0].VibF[0] = 0;
+	player_controller[0].VibF[1] = 0;
+
+	player_controller[0].configmode = 0;
+
+	Set_Controller_Mode();
+}
+
+/* menu state */
+static uint_fast8_t in_game_menu = false; /* inside GameMenu() */
+static uint_fast8_t menu_leave = false;   /* FN pressed: back to the game */
+static uint_fast8_t menu_idle = false;    /* the last menu poll found no button */
+
+static void enter_menu(void)
+{
+	//Sync and close any memcard files opened for writing
+	sioSyncMcds();
+
+	emu_running = false;
+	pl_pause();    // Tell plugin_lib we're pausing emu
+	menu_suppress = x7_input_poll();
+	menu_idle = false;
+	menu_leave = false;
+	in_game_menu = true;
+	GameMenu();
+	in_game_menu = false;
+	menu_leave = false;
+	emu_running = true;
+	game_suppress = x7_input_poll();
+	prev_held = game_suppress;
+	x7_vout_invalidate();   // the menu covered the black bands too
+	pl_resume();    // Tell plugin_lib we're reentering emu (redraws the screen)
+}
+
+void pad_update()
+{
+	uint32_t h = x7_input_poll();
+	uint32_t pressed = h & ~prev_held;
+	uint16_t b = 0xFFFF;
+
+	check_quit();
+
+	prev_held = h;
+	game_suppress &= h;
+	h &= ~game_suppress;
+
+	// FN: the menu
+	if (pressed & X7B_FN & ~game_suppress) {
+		enter_menu();
+		pad1 = 0xFFFF;
+		return;
+	}
+
+	if (h & X7B_B)      b &= ~(1 << DKEY_CROSS);
+	if (h & X7B_A)      b &= ~(1 << DKEY_CIRCLE);
+	if (h & X7B_X)      b &= ~(1 << DKEY_TRIANGLE);
+	if (h & X7B_Y)      b &= ~(1 << DKEY_SQUARE);
+	if (h & X7B_L1)     b &= ~(1 << DKEY_L1);
+	if (h & X7B_R1)     b &= ~(1 << DKEY_R1);
+	if (h & X7B_L2)     b &= ~(1 << DKEY_L2);
+	if (h & X7B_R2)     b &= ~(1 << DKEY_R2);
+	if (h & X7B_SELECT) b &= ~(1 << DKEY_SELECT);
+	if (h & X7B_START)  b &= ~(1 << DKEY_START);
+	if (h & X7B_UP)     b &= ~(1 << DKEY_UP);
+	if (h & X7B_DOWN)   b &= ~(1 << DKEY_DOWN);
+	if (h & X7B_LEFT)   b &= ~(1 << DKEY_LEFT);
+	if (h & X7B_RIGHT)  b &= ~(1 << DKEY_RIGHT);
+
+	// "Map DPAD to L-stick": the D-pad also moves the left stick
+	if (Config.AnalogArrow == 1) {
+		player_controller[0].joy_left_ax0 =
+			(h & X7B_LEFT) ? 0 : (h & X7B_RIGHT) ? 255 : 127;
+		player_controller[0].joy_left_ax1 =
+			(h & X7B_UP) ? 0 : (h & X7B_DOWN) ? 255 : 127;
+	} else {
+		player_controller[0].joy_left_ax0 = 127;
+		player_controller[0].joy_left_ax1 = 127;
+	}
+
+	pad1 = b;
+}
+
+unsigned short pad_read(int num)
+{
+	return (num == 0 ? pad1 : pad2);
+}
+
+static unsigned int menu_keys_now(void)
+{
+	uint32_t h = x7_input_poll();
+	unsigned int k = 0;
+
+	menu_suppress &= h;
+	h &= ~menu_suppress;
+
+	if (h & X7B_UP)     k |= MKEY_UP;
+	if (h & X7B_DOWN)   k |= MKEY_DOWN;
+	if (h & X7B_LEFT)   k |= MKEY_LEFT;
+	if (h & X7B_RIGHT)  k |= MKEY_RIGHT;
+	if (h & X7B_A)      k |= MKEY_A;       // confirm
+	if (h & X7B_B)      k |= MKEY_B;       // back
+	if (h & X7B_X)      k |= MKEY_X;
+	if (h & X7B_Y)      k |= MKEY_Y;
+	if (h & X7B_L1)     k |= MKEY_L;
+	if (h & X7B_R1)     k |= MKEY_R;
+	if (h & X7B_START)  k |= MKEY_START;
+	if (h & (X7B_SELECT | X7B_FN)) k |= MKEY_SELECT;  // one menu level back
+
+	// FN in the in-game menu: straight back to the game. frontend.c leaves
+	//  one menu level per KEY_SELECT, so KEY_SELECT is reported until
+	//  GameMenu() has returned.
+	if ((h & X7B_FN) && in_game_menu)
+		menu_leave = true;
+	if (menu_leave)
+		k |= MKEY_SELECT;
+	return k;
+}
+
+unsigned int port_menu_keys(void)
+{
+	unsigned int k;
+
+	check_quit();
+	k = menu_keys_now();
+
+	// No button twice in a row: frontend.c has drawn its screen and waits
+	//  for a button, polling every 50 ms. Sleep until an input event
+	//  instead (the menus need no periodic redraw).
+	if (k == 0 && menu_idle) {
+		x7_input_wait(x7_quit_requested() ? 100 : -1);
+		check_quit();
+		k = menu_keys_now();
+	}
+	menu_idle = (k == 0);
+	return k;
+}
+
+void port_menu_keys_reset(void)
+{
+	menu_suppress = x7_input_poll();
+	menu_idle = false;
+}
