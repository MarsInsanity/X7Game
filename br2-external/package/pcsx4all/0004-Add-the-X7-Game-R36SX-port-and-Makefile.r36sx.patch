+char *GetMemcardPath(int slot) {
+	switch(slot) {
+	case 1:
+		if (Config.McdSlot1 == -1) {
+			return NULL;
+		} else {
+			return McdPath1;
+		}
+	case 2:
+		if (Config.McdSlot2 == -1) {
+			return NULL;
+		} else {
+			return McdPath2;
+		}
+	}
+	return NULL;
+}
+
+
+void update_memcards(int load_mcd) {
+
+	if (Config.McdSlot1 == -1) {
+		McdPath1[0] = '\0';
+	} else if (Config.McdSlot1 == 0) {
+		if (string_is_empty(CdromId)) {
+			/* Fallback */
+			snprintf(McdPath1, sizeof(McdPath1), "%s/%s", memcardsdir, "card1.mcd");
+		} else {
+			snprintf(McdPath1, sizeof(McdPath1), "%s/%s.1.mcr", memcardsdir, CdromId);
+		}
+	} else {
+		snprintf(McdPath1, sizeof(McdPath1), "%s/mcd%03d.mcr", memcardsdir, (int)Config.McdSlot1);
+	}
+
+	if (Config.McdSlot2 == -1) {
+		McdPath2[0] = '\0';
+	} else if (Config.McdSlot2 == 0) {
+		if (string_is_empty(CdromId)) {
+			/* Fallback */
+			snprintf(McdPath2, sizeof(McdPath2), "%s/%s", memcardsdir, "card2.mcd");
+		} else {
+			snprintf(McdPath2, sizeof(McdPath2), "%s/%s.2.mcr", memcardsdir, CdromId);
+		}
+	} else {
+		snprintf(McdPath2, sizeof(McdPath2), "%s/mcd%03d.mcr", memcardsdir, (int)Config.McdSlot2);
+	}
+
+	if (load_mcd & 1)
+		LoadMcd(MCD1, GetMemcardPath(1)); //Memcard 1
+	if (load_mcd & 2)
+		LoadMcd(MCD2, GetMemcardPath(2)); //Memcard 2
+}
