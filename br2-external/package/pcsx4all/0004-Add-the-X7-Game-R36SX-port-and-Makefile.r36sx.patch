+#define _GNU_SOURCE	/* pipe2() */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <signal.h>
+#include <dirent.h>
+#include <time.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <poll.h>
+#include <linux/fb.h>
+#include <linux/kd.h>
+#include <linux/input.h>
+
+#include "x7_hw.h"
+
+/* sio.c: writes memory cards with unsaved changes, signal-safe */
+extern void sioEmergencyFlushMcds(void);
+
+/* ===================================================== framebuffer */
+
+volatile uint32_t *x7_fb = NULL;
+unsigned int x7_fb_pitch32 = 0;
+int x7_fb_bgr = 0;
+
+static int fb_fd = -1;
+static size_t fb_map_size;
+static struct fb_var_screeninfo fb_var_orig;
+static int fb_var_saved = 0;
+
+/* page flipping: the mapping, its two pages, the hidden one */
+#define SCALE_ATTR "/sys/bus/platform/devices/1883a000.framebuffer/scale"
+static uint8_t *fb_base;
+static unsigned int fb_line;		/* bytes per line */
+static int fb_pages = 1, fb_back = 0, flip_pending = 0;
+static struct fb_var_screeninfo fb_var_cur;
+/* hardware scaling */
+int x7_fb_hwscale = 0;
+static int scale_fd = -1;
+static char scale_now[48];
+
+static volatile uint32_t *fb_page(int page)
+{
+	return (volatile uint32_t *)(fb_base + (size_t)page * X7_FB_H * fb_line);
+}
+static int tty_fd = -1;
+static int tty_mode_orig = -1;
+static volatile sig_atomic_t video_restored = 0;
+
+static int open_console(void)
+{
+	int mode;
+
+	/* stdin is the console (tty1) when the game list starts us */
+	if (ioctl(0, KDGETMODE, &mode) == 0) {
+		int fd = fcntl(0, F_DUPFD_CLOEXEC, 3);
+		if (fd >= 0) {
+			tty_mode_orig = mode;
+			return fd;
+		}
+	}
+	{
+		int fd = open("/dev/tty0", O_RDWR | O_CLOEXEC);
+		if (fd >= 0 && ioctl(fd, KDGETMODE, &mode) == 0) {
+			tty_mode_orig = mode;
+			return fd;
+		}
+		if (fd >= 0)
+			close(fd);
+	}
+	return -1;
+}
+
+int x7_video_init(void)
+{
+	struct fb_var_screeninfo var;
+	struct fb_fix_screeninfo fix;
+	void *p;
+
+	fb_fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+	if (fb_fd < 0) {
+		perror("x7: /dev/fb0");
+		return -1;
+	}
+	if (ioctl(fb_fd, FBIOGET_VSCREENINFO, &fb_var_orig) < 0) {
+		perror("x7: FBIOGET_VSCREENINFO");
+		goto fail;
+	}
+	fb_var_saved = 1;
+
+	/* Text console off first: switched while still drawing, it would
+	 * redraw the game list in 16 bits with its 32-bit colours (a yellow
+	 * haze that stays after the game) */
+	tty_fd = open_console();
+	if (tty_fd >= 0 && ioctl(tty_fd, KDSETMODE, KD_GRAPHICS) < 0)
+		perror("x7: KDSETMODE");
+
+	/* RGB565, two pages (page flipping) where the kernel offers them */
+	var = fb_var_orig;
+	var.bits_per_pixel = 16;
+	var.xoffset = 0;
+	var.yoffset = 0;
+	var.yres_virtual = X7_FB_H * 2;
+	var.activate = FB_ACTIVATE_NOW;
+	if (ioctl(fb_fd, FBIOPUT_VSCREENINFO, &var) < 0) {
+		var.yres_virtual = X7_FB_H;	/* an older kernel: one page */
+		if (ioctl(fb_fd, FBIOPUT_VSCREENINFO, &var) < 0)
+			perror("x7: FBIOPUT_VSCREENINFO");
+	}
+	if (ioctl(fb_fd, FBIOGET_VSCREENINFO, &var) < 0 ||
+	    ioctl(fb_fd, FBIOGET_FSCREENINFO, &fix) < 0) {
+		perror("x7: FBIOGET");
+		goto fail;
+	}
+	if (var.bits_per_pixel != 16 || var.xres < X7_FB_W || var.yres < X7_FB_H ||
+	    fix.line_length < X7_FB_W * 2 ||
+	    fix.smem_len < (unsigned long)fix.line_length * (var.yoffset + X7_FB_H)) {
+		fprintf(stderr, "x7: unusable framebuffer mode %ux%u %ubpp, line %u bytes\n",
+			var.xres, var.yres, var.bits_per_pixel, fix.line_length);
+		goto fail;
+	}
+	x7_fb_bgr = (var.blue.offset == 11 && var.red.offset == 0);
+	printf("x7: framebuffer %ux%u 16bpp (%s565), line %u bytes\n",
+	       var.xres, var.yres, x7_fb_bgr ? "BGR" : "RGB", fix.line_length);
+
+	fb_map_size = fix.smem_len;
+	p = mmap(NULL, fb_map_size, PROT_READ | PROT_WRITE, MAP_SHARED, fb_fd, 0);
+	if (p == MAP_FAILED) {
+		perror("x7: mmap /dev/fb0");
+		goto fail;
+	}
+	x7_fb_pitch32 = fix.line_length / 4;
+	fb_base = p;
+	fb_line = fix.line_length;
+	fb_var_cur = var;
+	fb_pages = (var.yres_virtual >= 2 * X7_FB_H &&
+		    fix.smem_len >= 2UL * X7_FB_H * fix.line_length) ? 2 : 1;
+	video_restored = 0;
+	/* clear every page; draw into the hidden one (page 0 is shown) */
+	x7_fb = fb_page(0);
+	x7_fb_clear_lines(0, X7_FB_H);
+	if (fb_pages == 2) {
+		x7_fb = fb_page(1);
+		x7_fb_clear_lines(0, X7_FB_H);
+	}
+	fb_back = fb_pages - 1;
+	x7_fb = fb_page(fb_back);
+	flip_pending = 0;
+	/* hardware scaling, when the system turned it on (x7game.cfg) */
+	if (access("/run/x7-hwscale", F_OK) == 0) {
+		scale_fd = open(SCALE_ATTR, O_WRONLY | O_CLOEXEC);
+		x7_fb_hwscale = scale_fd >= 0;
+	}
+	scale_now[0] = 0;
+	printf("x7: %s, %s\n", fb_pages == 2 ? "page flipping" : "one page",
+	       x7_fb_hwscale ? "hardware scaling" : "scaling on the CPU");
+	return 0;
+
+fail:
+	x7_video_restore();
+	return -1;
+}
+
+void x7_video_restore(void)
+{
+	/* only system calls and plain stores: also used from signal handlers */
+	if (video_restored)
+		return;
+	video_restored = 1;
+
+	/* the text console needs the 1:1 picture back */
+	if (scale_fd >= 0) {
+		ssize_t r = write(scale_fd, "off", 3);
+
+		(void)r;
+		close(scale_fd);
+		scale_fd = -1;
+		x7_fb_hwscale = 0;
+	}
+	if (x7_fb) {
+		x7_fb_clear_lines(0, X7_FB_H);
+		x7_fb = NULL;
+	}
+	/* fb_var_orig is one page shown from the top (yres_virtual 480,
+	 * yoffset 0) at the console's depth */
+	if (fb_fd >= 0) {
+		if (fb_var_saved) {
+			struct fb_var_screeninfo var = fb_var_orig;
+			var.activate = FB_ACTIVATE_NOW;
+			ioctl(fb_fd, FBIOPUT_VSCREENINFO, &var);
+		}
+		close(fb_fd);
+		fb_fd = -1;
+	}
+	if (tty_fd >= 0) {
+		ioctl(tty_fd, KDSETMODE, tty_mode_orig >= 0 ? tty_mode_orig : KD_TEXT);
+		close(tty_fd);
+		tty_fd = -1;
+	}
+}
+
+void x7_fb_clear_lines(int y0, int y1)
+{
+	int y, n;
+
+	if (!x7_fb)
+		return;
+	if (y0 < 0) y0 = 0;
+	if (y1 > X7_FB_H) y1 = X7_FB_H;
+	for (y = y0; y < y1; y++) {
+		volatile uint32_t *d = x7_fb + (unsigned int)y * x7_fb_pitch32;
+		for (n = 0; n < X7_FB_W / 2; n += 8) {
+			d[0] = 0; d[1] = 0; d[2] = 0; d[3] = 0;
+			d[4] = 0; d[5] = 0; d[6] = 0; d[7] = 0;
+			d += 8;
+		}
+	}
+}
+
+void x7_begin_frame(void)
+{
+	uint32_t crtc = 0;
+
+	if (flip_pending && fb_fd >= 0) {
+		ioctl(fb_fd, FBIO_WAITFORVSYNC, &crtc);
+		flip_pending = 0;
+	}
+}
+
+void x7_present(void)
+{
+	if (fb_pages < 2 || fb_fd < 0 || !x7_fb)
+		return;
+	fb_var_cur.xoffset = 0;
+	fb_var_cur.yoffset = fb_back * X7_FB_H;
+	fb_var_cur.activate = FB_ACTIVATE_NOW;
+	if (ioctl(fb_fd, FBIOPAN_DISPLAY, &fb_var_cur) < 0) {
+		/* refused: draw on the page that is shown from now on */
+		perror("x7: FBIOPAN_DISPLAY");
+		fb_pages = 1;
+		fb_back ^= 1;
+		x7_fb = fb_page(fb_back);
+		return;
+	}
+	fb_back ^= 1;
+	x7_fb = fb_page(fb_back);
+	flip_pending = 1;
+}
+
+int x7_scale(int w, int h, int out_w, int out_h, int sharp)
+{
+	char s[48];
+	int n;
+
+	if (scale_fd < 0)
+		return -1;
+	if (w)
+		n = snprintf(s, sizeof(s), "%d %d %d %d %s", w, h, out_w, out_h,
+			     sharp ? "sharp" : "smooth");
+	else
+		n = snprintf(s, sizeof(s), "off");
+	if (!strcmp(s, scale_now))
+		return 0;
+	if (pwrite(scale_fd, s, n, 0) < 0) {
+		fprintf(stderr, "x7: hardware scaling refused (%s): scaling on the CPU\n", s);
+		close(scale_fd);
+		scale_fd = -1;
+		x7_fb_hwscale = 0;
+		scale_now[0] = 0;
+		return -1;
+	}
+	strcpy(scale_now, s);
+	return 0;
+}
+
+void x7_present_canvas_2x(const uint16_t *canvas)
+{
+	uint32_t line[X7_FB_W / 2];
+	int x, y;
+
+	if (!x7_fb)
+		return;
+	x7_begin_frame();
+	/* the display hardware doubles it: write it 1:1 */
+	if (x7_fb_hwscale && x7_scale(X7_FB_W / 2, X7_FB_H / 2, X7_FB_W, X7_FB_H, 1) == 0) {
+		for (y = 0; y < X7_FB_H / 2; y++) {
+			const uint16_t *s = canvas + y * (X7_FB_W / 2);
+			uint16_t *l16 = (uint16_t *)line;
+
+			if (x7_fb_bgr) {
+				for (x = 0; x < X7_FB_W / 2; x++) {
+					uint32_t c = s[x];
+					l16[x] = ((c & 0x1f) << 11) | (c & 0x7e0) | (c >> 11);
+				}
+			} else {
+				memcpy(l16, s, X7_FB_W);
+			}
+			x7_fb_write_words(y, line, X7_FB_W / 4);
+		}
+		x7_present();
+		return;
+	}
+	x7_scale(0, 0, 0, 0, 0);
+	for (y = 0; y < X7_FB_H / 2; y++) {
+		const uint16_t *s = canvas + y * (X7_FB_W / 2);
+		if (x7_fb_bgr) {
+			for (x = 0; x < X7_FB_W / 2; x++) {
+				uint32_t c = s[x];
+				c = ((c & 0x1f) << 11) | (c & 0x7e0) | (c >> 11);
+				line[x] = c | (c << 16);
+			}
+		} else {
+			for (x = 0; x < X7_FB_W / 2; x++) {
+				uint32_t c = s[x];
+				line[x] = c | (c << 16);
+			}
+		}
+		x7_fb_write_line(2 * y, line);
+		x7_fb_write_line(2 * y + 1, line);
+	}
+	x7_present();
+}
+
+void x7_fb_text(int x, int y, const char *text)
+{
+	int len = (int)strlen(text);
+	int max = (X7_FB_W - x) / 16;
+	int row, i, b;
+
+	if (!x7_fb || y < 0 || y + 16 > X7_FB_H || x < 0)
+		return;
+	if (len > max)
+		len = max;
+	x &= ~1;
+	for (row = 0; row < 8; row++) {
+		volatile uint32_t *d0 = x7_fb + (unsigned int)(y + 2 * row) * x7_fb_pitch32 + x / 2;
+		volatile uint32_t *d1 = d0 + x7_fb_pitch32;
+		for (i = 0; i < len; i++) {
+			unsigned char c = (unsigned char)text[i];
+			unsigned char bits = x7_font8x8[(c > 127 ? '?' : c) * 8 + row];
+			for (b = 0; b < 8; b++) {
+				uint32_t w = (bits & (0x80 >> b)) ? 0xffffffffu : 0;
+				*d0++ = w;
+				*d1++ = w;
+			}
+		}
+	}
+}
+
+/* ===================================================== buttons */
+
+#define PAD_NAME "X7 Game Gamepad"
+#define MAX_IN 8
+#define LONG_BITS (sizeof(long) * 8)
+#define TEST_BIT(a, n) (((a)[(n) / LONG_BITS] >> ((n) % LONG_BITS)) & 1)
+
+static int in_fd[MAX_IN];
+static int n_in = 0;
+static int have_pad = 0;   /* in_fd[0] is the virtual pad (and the only fd) */
+static uint32_t held = 0;
+static unsigned int last_scan_ms = 0;
+
+static uint32_t key_bit(unsigned int code)
+{
+	switch (code) {
+	case BTN_SOUTH:      return X7B_B;
+	case BTN_EAST:       return X7B_A;
+	case BTN_NORTH:      return X7B_X;
+	case BTN_WEST:       return X7B_Y;
+	case BTN_TL:         return X7B_L1;
+	case BTN_TR:         return X7B_R1;
+	case BTN_TL2:        return X7B_L2;
+	case BTN_TR2:        return X7B_R2;
+	case BTN_SELECT:     return X7B_SELECT;
+	case BTN_START:      return X7B_START;
+	case BTN_MODE:       return X7B_FN;
+	case BTN_DPAD_UP:    return X7B_UP;
+	case BTN_DPAD_DOWN:  return X7B_DOWN;
+	case BTN_DPAD_LEFT:  return X7B_LEFT;
+	case BTN_DPAD_RIGHT: return X7B_RIGHT;
+	}
+	return 0;
+}
+
+static void set_hat(unsigned int axis, int value)
+{
+	if (axis == ABS_HAT0X) {
+		held &= ~(X7B_LEFT | X7B_RIGHT);
+		if (value < 0) held |= X7B_LEFT;
+		else if (value > 0) held |= X7B_RIGHT;
+	} else if (axis == ABS_HAT0Y) {
+		held &= ~(X7B_UP | X7B_DOWN);
+		if (value < 0) held |= X7B_UP;
+		else if (value > 0) held |= X7B_DOWN;
+	}
+}
+
+/* after SYN_DROPPED (or on open): read the device's current state */
+static void resync(int fd)
+{
+	unsigned long keys[(KEY_MAX + LONG_BITS) / LONG_BITS];
+	struct input_absinfo abs;
+	unsigned int c;
+
+	memset(keys, 0, sizeof(keys));
+	if (ioctl(fd, EVIOCGKEY(sizeof(keys)), keys) >= 0) {
+		for (c = BTN_MISC; c <= BTN_DPAD_RIGHT; c++) {
+			uint32_t b = key_bit(c);
+			if (!b)
+				continue;
+			if (TEST_BIT(keys, c))
+				held |= b;
+			else
+				held &= ~b;
+		}
+	}
+	if (ioctl(fd, EVIOCGABS(ABS_HAT0X), &abs) >= 0)
+		set_hat(ABS_HAT0X, abs.value);
+	if (ioctl(fd, EVIOCGABS(ABS_HAT0Y), &abs) >= 0)
+		set_hat(ABS_HAT0Y, abs.value);
+}
+
+static void close_inputs(void)
+{
+	while (n_in > 0)
+		close(in_fd[--n_in]);
+	have_pad = 0;
+	held = 0;
+}
+
+/* want_pad: opens the virtual pad only (returns its fd, -1 if absent);
+ * else adds every device with pad buttons except the virtual pad to
+ * in_fd[] (returns how many fds are open) */
+static int scan_inputs(int want_pad)
+{
+	DIR *d = opendir("/dev/input");
+	struct dirent *e;
+	int found = -1;
+
+	if (!d)
+		return want_pad ? -1 : n_in;
+	while ((e = readdir(d))) {
+		unsigned long keys[(KEY_MAX + LONG_BITS) / LONG_BITS];
+		char path[300], name[96] = "";
+		int fd, ok;
+
+		if (strncmp(e->d_name, "event", 5))
+			continue;
+		if (!want_pad && n_in >= MAX_IN)
+			break;
+		snprintf(path, sizeof(path), "/dev/input/%s", e->d_name);
+		fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name);
+		memset(keys, 0, sizeof(keys));
+		ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(keys)), keys);
+		if (want_pad)
+			ok = !strcmp(name, PAD_NAME);
+		else
+			ok = strcmp(name, PAD_NAME) &&
+			     (TEST_BIT(keys, BTN_SOUTH) || TEST_BIT(keys, BTN_DPAD_UP));
+		if (!ok) {
+			close(fd);
+			continue;
+		}
+		printf("x7: buttons from %s (%s)\n", path, name);
+		if (want_pad) {
+			found = fd;
+			break;
+		}
+		in_fd[n_in++] = fd;
+		resync(fd);
+	}
+	closedir(d);
+	return want_pad ? found : n_in;
+}
+
+/* the virtual pad replaces whatever raw devices were open */
+static int use_pad(void)
+{
+	int fd = scan_inputs(1);
+
+	if (fd < 0)
+		return 0;
+	close_inputs();
+	in_fd[0] = fd;
+	n_in = 1;
+	have_pad = 1;
+	resync(fd);
+	return 1;
+}
+
+void x7_input_init(int wait_ms)
+{
+	unsigned int end = x7_ticks_ms() + (unsigned int)wait_ms;
+
+	close_inputs();
+	for (;;) {
+		if (use_pad())
+			break;
+		if ((int)(x7_ticks_ms() - end) >= 0) {
+			/* raw buttons until the pad shows up (see x7_input_poll) */
+			scan_inputs(0);
+			break;
+		}
+		usleep(100000);
+	}
+	if (!n_in)
+		fprintf(stderr, "x7: no gamepad found\n");
+	last_scan_ms = x7_ticks_ms();
+}
+
+void x7_input_shutdown(void)
+{
+	close_inputs();
+}
+
+uint32_t x7_input_poll(void)
+{
+	struct input_event ev[32];
+	int i, j;
+
+	for (i = 0; i < n_in; i++) {
+		for (;;) {
+			ssize_t r = read(in_fd[i], ev, sizeof(ev));
+			if (r < 0 && errno == EINTR)
+				continue;
+			if (r <= 0) {
+				if (r < 0 && errno != EAGAIN) {
+					/* device gone (x7-padd restarted?) */
+					close(in_fd[i]);
+					in_fd[i] = in_fd[--n_in];
+					have_pad = 0;
+					held = 0;
+					i--;
+				}
+				break;
+			}
+			for (j = 0; j < (int)(r / sizeof(ev[0])); j++) {
+				if (ev[j].type == EV_KEY) {
+					uint32_t b = key_bit(ev[j].code);
+					if (b) {
+						if (ev[j].value)
+							held |= b;
+						else
+							held &= ~b;
+					}
+				} else if (ev[j].type == EV_ABS) {
+					set_hat(ev[j].code, ev[j].value);
+				} else if (ev[j].type == EV_SYN && ev[j].code == SYN_DROPPED) {
+					resync(in_fd[i]);
+				}
+			}
+		}
+	}
+
+	/* Not on the virtual pad (missing at start, or x7-padd restarted):
+	 * look for it once a second and switch to it; meanwhile the raw
+	 * button devices, reopened if they went away too. */
+	if (!have_pad && (unsigned int)(x7_ticks_ms() - last_scan_ms) >= 1000) {
+		last_scan_ms = x7_ticks_ms();
+		if (!use_pad() && n_in == 0)
+			scan_inputs(0);
+	}
+	return held;
+}
+
+/* ===================================================== signals */
+
+static volatile sig_atomic_t quit_requested = 0;
+/* self-pipe: on_quit_signal() writes a byte, x7_input_wait() polls the read
+ * end, so a SIGTERM that comes just before poll() still wakes it */
+static int quit_pipe[2] = { -1, -1 };
+
+uint32_t x7_input_wait(int timeout_ms)
+{
+	struct pollfd pfd[MAX_IN + 1];
+	int i, n = 0;
+
+	/* without the pad, wake up at least once a second to look for it */
+	if (!have_pad && (timeout_ms < 0 || timeout_ms > 1000))
+		timeout_ms = 1000;
+	for (i = 0; i < n_in; i++) {
+		pfd[n].fd = in_fd[i];
+		pfd[n].events = POLLIN;
+		pfd[n++].revents = 0;
+	}
+	if (quit_pipe[0] >= 0) {
+		pfd[n].fd = quit_pipe[0];
+		pfd[n].events = POLLIN;
+		pfd[n++].revents = 0;
+	}
+	/* a signal arriving during poll() interrupts it; one arriving before
+	 * makes the pipe readable (it is never drained: once asked to quit,
+	 * every later wait returns at once) */
+	if (!quit_requested)
+		poll(pfd, (nfds_t)n, timeout_ms);
+	return x7_input_poll();
+}
+
+int x7_quit_requested(void)
+{
+	return quit_requested;
+}
+
+static void emergency_cleanup(void)
+{
+	sioEmergencyFlushMcds();
+	x7_video_restore();
+}
+
+static void on_quit_signal(int sig)
+{
+	int saved_errno = errno;
+
+	(void)sig;
+	if (quit_pipe[1] >= 0 && write(quit_pipe[1], "q", 1) < 0) {
+		/* pipe full: it is readable already */
+	}
+	errno = saved_errno;
+	if (!quit_requested) {
+		quit_requested = 1;
+		/* the main loop exits within a frame, or within 2 s when a game
+		 * is writing a memory card; if it is stuck, SIGALRM finishes the
+		 * job (X7 Game's shutdown waits 5 s) */
+		alarm(4);
+	}
+}
+
+static void on_alarm(int sig)
+{
+	static const char msg[] = "x7: no clean exit within 4 s, forcing it\n";
+	(void)sig;
+	if (write(2, msg, sizeof(msg) - 1) < 0) { /* nothing to do */ }
+	emergency_cleanup();
+	_exit(1);
+}
+
+static void on_crash(int sig)
+{
+	emergency_cleanup();
+	signal(sig, SIG_DFL);
+	raise(sig);
+	_exit(128 + sig);
+}
+
+void x7_signals_init(void)
+{
+	struct sigaction sa;
+	static const int quit_sigs[] = { SIGTERM, SIGINT, SIGHUP, SIGQUIT };
+	static const int crash_sigs[] = { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT };
+	unsigned int i;
+
+	if (pipe2(quit_pipe, O_NONBLOCK | O_CLOEXEC) < 0) {
+		perror("x7: pipe2");
+		quit_pipe[0] = quit_pipe[1] = -1;
+	}
+
+	memset(&sa, 0, sizeof(sa));
+	sigemptyset(&sa.sa_mask);
+
+	sa.sa_handler = on_quit_signal;
+	sa.sa_flags = SA_RESTART;
+	for (i = 0; i < sizeof(quit_sigs) / sizeof(quit_sigs[0]); i++)
+		sigaction(quit_sigs[i], &sa, NULL);
+
+	sa.sa_handler = on_alarm;
+	sa.sa_flags = 0;
+	sigaction(SIGALRM, &sa, NULL);
+
+	sa.sa_handler = on_crash;
+	sa.sa_flags = SA_NODEFER | SA_RESETHAND;
+	for (i = 0; i < sizeof(crash_sigs) / sizeof(crash_sigs[0]); i++)
+		sigaction(crash_sigs[i], &sa, NULL);
+
+	signal(SIGPIPE, SIG_IGN);
+}
+
+unsigned int x7_ticks_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (unsigned int)ts.tv_sec * 1000u + (unsigned int)(ts.tv_nsec / 1000000);
+}
diff --git a/src/port/r36sx/x7_hw.h b/src/port/r36sx/x7_hw.h
new file mode 100644
index 0000000..3bc1e72
--- /dev/null
+++ b/src/port/r36sx/x7_hw.h
@@ -0,0 +1,131 @@
+#ifndef X7_HW_H
+#define X7_HW_H
+
+/*
+ * X7 Game (R36SX) hardware layer for PCSX4ALL: framebuffer, buttons,
+ * signals. No SDL.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <stdint.h>
+
+/* ------------------------------------------------------------- screen */
+
+/* The screen is 640x480, RGB565 (or BGR565, see x7_fb_bgr). The memory is
+ * UNCACHED: only write it, with 32-bit stores, never read it back. */
+#define X7_FB_W 640
+#define X7_FB_H 480
+
+extern volatile uint32_t *x7_fb;   /* NULL until x7_video_init() succeeded */
+extern unsigned int x7_fb_pitch32; /* framebuffer line length in 32-bit words */
+extern int x7_fb_bgr;              /* 1: blue in the top bits (BGR565) */
+
+int  x7_video_init(void);
+/* Restores the framebuffer mode and the console mode (KD_TEXT) found at
+ * start. Safe to call more than once and from a signal handler. */
+void x7_video_restore(void);
+
+/* Writes a 640-pixel line (320 words of two pixels) to screen line y. */
+static inline void x7_fb_write_line(int y, const uint32_t *src)
+{
+	volatile uint32_t *d = x7_fb + (unsigned int)y * x7_fb_pitch32;
+	int n;
+	for (n = 0; n < X7_FB_W / 2; n += 8) {
+		d[0] = src[0]; d[1] = src[1]; d[2] = src[2]; d[3] = src[3];
+		d[4] = src[4]; d[5] = src[5]; d[6] = src[6]; d[7] = src[7];
+		d += 8; src += 8;
+	}
+}
+
+/* Writes n words (2n pixels) to line y from column 0 (a frame the display
+ * hardware enlarges, see x7_scale). */
+static inline void x7_fb_write_words(int y, const uint32_t *src, int n)
+{
+	volatile uint32_t *d = x7_fb + (unsigned int)y * x7_fb_pitch32;
+	int i;
+	for (i = 0; i < n; i++)
+		d[i] = src[i];
+}
+
+/* Fills screen lines y0..y1-1 with black. */
+void x7_fb_clear_lines(int y0, int y1);
+
+/* Page flipping (X7 Game kernel patch 0020): with two pages, x7_fb points at
+ * the hidden one; x7_present() shows it at the next frame boundary and the
+ * other page becomes the drawing page. x7_begin_frame() waits, if needed,
+ * until the last flip took effect, so the page drawn next is not on the
+ * screen any more. Without page flipping both do nothing. */
+void x7_begin_frame(void);
+void x7_present(void);
+
+/* Hardware scaling (kernel patch 0019, when /run/x7-hwscale exists): the
+ * top-left w x h pixels of the page are shown enlarged in a centred
+ * out_w x out_h window; w = 0 turns it off. Returns 0 when done. */
+extern int x7_fb_hwscale;
+int x7_scale(int w, int h, int out_w, int out_h, int sharp);
+
+/* Shows a 320x240 RGB565 canvas doubled on the whole screen. */
+void x7_present_canvas_2x(const uint16_t *canvas);
+
+/* Draws text (8x8 font doubled to 16x16, opaque: white on black) straight
+ * to the screen at screen pixel x (even), y. */
+void x7_fb_text(int x, int y, const char *text);
+
+/* port.c: the 8x8 font, 8 bytes per character */
+extern const unsigned char x7_font8x8[];
+
+/* ------------------------------------------------------------- buttons */
+
+enum {
+	X7B_B      = 1 << 0,   /* BTN_SOUTH, bottom */
+	X7B_A      = 1 << 1,   /* BTN_EAST, right */
+	X7B_X      = 1 << 2,   /* BTN_NORTH, top */
+	X7B_Y      = 1 << 3,   /* BTN_WEST, left */
+	X7B_L1     = 1 << 4,
+	X7B_R1     = 1 << 5,
+	X7B_L2     = 1 << 6,
+	X7B_R2     = 1 << 7,
+	X7B_SELECT = 1 << 8,
+	X7B_START  = 1 << 9,
+	X7B_FN     = 1 << 10,  /* BTN_MODE */
+	X7B_UP     = 1 << 11,
+	X7B_DOWN   = 1 << 12,
+	X7B_LEFT   = 1 << 13,
+	X7B_RIGHT  = 1 << 14,
+};
+
+/* Opens "X7 Game Gamepad" (waits up to wait_ms for it), else every input
+ * device with gamepad buttons; in that case x7_input_poll() keeps looking
+ * for the virtual pad once a second and switches to it. */
+void x7_input_init(int wait_ms);
+void x7_input_shutdown(void);
+/* Reads the pending input events; returns the X7B_* bits held now. */
+uint32_t x7_input_poll(void);
+/* Sleeps until an input event (or timeout_ms; -1: no timeout, but at most
+ * 1 s while the virtual pad is missing; a signal also wakes it), then does
+ * x7_input_poll(). */
+uint32_t x7_input_wait(int timeout_ms);
+
+/* ------------------------------------------------------------- video out */
+
+/* vout_x7.c: redraw the black bands above/below the picture with the next
+ * frame (after the menu covered the whole screen) */
+void x7_vout_invalidate(void);
+
+/* ------------------------------------------------------------- signals */
+
+/* SIGTERM/SIGINT/SIGHUP/SIGQUIT ask the emulator to quit (the main loop
+ * sees x7_quit_requested() and exits cleanly within a frame, or within 2 s
+ * while a game writes a memory card; if it has not within 4 seconds, the
+ * screen is restored and the memory cards are written from the signal
+ * handler). Crash signals restore the screen too. */
+void x7_signals_init(void);
+int  x7_quit_requested(void);
+
+unsigned int x7_ticks_ms(void);
+
+#endif
