+// if [CdromId].bin is exsit, use the spec bios
+void check_spec_bios() {
+	FILE *f = NULL;
+	char bios[MAXPATHLEN * 2];
+	snprintf(bios, sizeof(bios), "%s/%s.bin", Config.BiosDir, CdromId);
+	f = fopen(bios, "rb");
+	if (f == NULL) {
+		strcpy(BiosFile, Config.Bios);
+		return;
+	}
+	fclose(f);
+	snprintf(BiosFile, sizeof(BiosFile), "%s.bin", CdromId);
+}
