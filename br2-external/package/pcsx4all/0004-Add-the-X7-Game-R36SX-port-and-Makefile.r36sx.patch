Add the X7 Game (R36SX) port and Makefile.r36sx

src/port/r36sx: no SDL. Video straight to /dev/fb0 at 640x480 RGB565, the
PS1 picture scaled to fill the screen (exact 2x for 320x240, nearest
neighbour otherwise), written with sequential 32-bit stores (the
framebuffer is uncached); the menu (320x240) is shown doubled. Buttons from
the "X7 Game Gamepad" evdev device (B = Cross, A = Circle, X = Triangle,
Y = Square, L1/R1/L2/R2, SELECT, START, D-pad; FN = menu, and FN in the
menu = straight back to the game), raw button devices until the virtual
pad shows up. The menu sleeps in poll() while no button is pressed. Sound
through spu_pcsxrearmed's ALSA driver. BIOS in /share/bios (HLE when
none), memory cards and save states in /share/saves/psx, settings in
/share/system/pcsx4all. SIGTERM/SIGINT: a memory card save in progress may
finish (up to 2 s), then memory cards flushed, screen and console
restored, clean exit; a 4 s watchdog forces it.

With X7 Game's kernel (patches 0019/0020): page flipping (two RGB565
pages, every frame drawn into the hidden one and shown at the next frame
boundary, so it never tears) and, when /run/x7-hwscale exists, hardware
scaling (the PS1 picture and the menu written 1:1, the display enlarges
them: sharp for exact multiples, filtered otherwise). Falls back to one
page and CPU scaling on other kernels.
diff --git a/Makefile.r36sx b/Makefile.r36sx
new file mode 100644
index 0000000..83240d2
--- /dev/null
+++ b/Makefile.r36sx
@@ -0,0 +1,188 @@
+#########################################################################
+## PCSX4ALL for X7 Game on the R36SX (HiChip E3100: one MIPS 74Kc core,
+## MIPS32r2, hard-float, little-endian; no GPU; 640x480 framebuffer)
+##
+## No SDL: src/port/r36sx writes /dev/fb0 (RGB565, the PS1 picture scaled
+## to 640x480), reads the "X7 Game Gamepad" evdev device and plays sound
+## through ALSA (spu_pcsxrearmed's alsa driver). gpu_unai with gpulib,
+## spu_pcsxrearmed, the MIPS dynarec, CHD through libchdr (src/libchdr).
+##
+## Cross-compile:  make -f Makefile.r36sx CC=... CXX=...
+## (CC/CXX/LD/CFLAGS come from the environment or the command line.)
+#########################################################################
+
+TARGET = pcsx4all
+PORT   = r36sx
+GPU    = gpu_unai
+SPU    = spu_pcsxrearmed
+RECOMPILER ?= mips
+SUPPORT_CHD ?= 1
+
+CC  ?= gcc
+CXX ?= g++
+LD  := $(CXX)
+RM   = rm -f
+MD   = mkdir -p
+
+# If V=1 was passed to 'make', don't hide commands:
+ifeq ($(V),1)
+	HIDECMD :=
+else
+	HIDECMD := @
+endif
+
+OPT ?= -O2
+
+# MIPS32r2 for the 74Kc. No DSP ASE (-mdsp/-mdspr2): not verified on this
+# chip. FP mode stays the toolchain default (FPXX).
+# -mno-check-zero-division: as in the upstream release builds (faster
+#  software rendering; PS1 code never reaches a host division by zero).
+# -mplt -mno-shared -fno-pie / -no-pie: a non-PIC executable at the usual
+#  0x400000: the dynarec's code buffer (.bss) and the C code it calls must
+#  share one 256 MiB J/JAL region, and it maps PS1 memory at the fixed
+#  addresses 0x10000000 and 0x20000000 (see recompiler/mips/mem_mapping.h).
+ifeq ($(RECOMPILER),mips)
+C_ARCH = -mips32r2 -mtune=74kc -mno-check-zero-division -mplt -mno-shared
+endif
+C_ARCH += -fno-pie
+
+CFLAGS += $(C_ARCH) $(OPT) -fno-strict-aliasing -fcommon \
+	-Wall -Wno-sign-compare -Wno-cast-align -Wno-unused-variable \
+	-Wno-unused-function -Wno-unused-but-set-variable \
+	-Isrc -Isrc/spu/$(SPU) -D$(SPU) -Isrc/gpu/$(GPU) \
+	-Isrc/port/$(PORT) \
+	-Isrc/plugin_lib \
+	-Isrc/external_lib -Isrc/port/common \
+	-DR36SX -DNO_SDL -DNO_HWSCALE -DNOJOYSTICK_AVAILABLE -DTIME_IN_MSEC \
+	-D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 \
+	-DXA_HACK \
+	-DINLINE="static __inline__" -Dasm="__asm__ __volatile__"
+
+# Convert plugin names to uppercase and make them CFLAG defines
+CFLAGS += -D$(shell echo $(GPU) | tr a-z A-Z)
+CFLAGS += -D$(shell echo $(SPU) | tr a-z A-Z)
+
+ifdef RECOMPILER
+CFLAGS += -DPSXREC -D$(RECOMPILER)
+# PS1 RAM (2 MiB) and the block table (2 MiB) are mapped/mirrored at fixed
+# addresses through a tmpfs file: POSIX shared memory in /dev/shm (default,
+# MIRRORING=shm) or a file in /tmp (MIRRORING=tmp). Up to 4 MiB of that
+# tmpfs is used while the game runs; when it is full, the emulator dies of
+# SIGBUS.
+MIRRORING ?= shm
+ifeq ($(MIRRORING),tmp)
+CFLAGS += -DTMPFS_MIRRORING '-DTMPFS_DIR="/tmp"'
+else
+CFLAGS += -DSHMEM_MIRRORING
+endif
+endif
+
+# GCC 14 turned these old-C warnings into errors
+CFLAGS_C = -Wno-error=implicit-function-declaration \
+	-Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
+	-Wno-error=implicit-int
+ifneq ($(shell $(CC) -Wno-error=return-mismatch -E -x c /dev/null -o /dev/null 2>/dev/null && echo y),)
+CFLAGS_C += -Wno-error=return-mismatch
+endif
+
+LDFLAGS += -no-pie -Wl,--as-needed
+LIBS = -lasound -lz -lrt -lpthread -lm
+
+OBJDIRS = obj obj/gpu obj/gpu/$(GPU) obj/gpu/gpulib obj/spu obj/spu/$(SPU) \
+	  obj/port obj/port/$(PORT) \
+	  obj/plugin_lib obj/external_lib obj/port/common
+
+all: maketree $(TARGET)
+
+OBJS = \
+	obj/r3000a.o obj/misc.o obj/plugins.o obj/psxmem.o obj/psxhw.o \
+	obj/psxcounters.o obj/psxdma.o obj/psxbios.o obj/psxhle.o obj/psxevents.o \
+	obj/psxcommon.o \
+	obj/plugin_lib/plugin_lib.o obj/plugin_lib/pl_sshot.o \
+	obj/plugin_lib/perfmon.o \
+	obj/psxinterpreter.o \
+	obj/mdec.o obj/decode_xa.o \
+	obj/cdriso.o obj/cdrom.o obj/ppf.o obj/cheat.o \
+	obj/sio.o obj/pad.o obj/gte.o \
+	obj/external_lib/ioapi.o obj/external_lib/unzip.o \
+	obj/port/common/frontend.o obj/port/common/cdrom_hacks.o
+
+ifdef RECOMPILER
+OBJDIRS += obj/recompiler obj/recompiler/$(RECOMPILER)
+OBJS += \
+	obj/recompiler/mips/recompiler.o \
+	obj/recompiler/mips/host_asm.o \
+	obj/recompiler/mips/mem_mapping.o \
+	obj/recompiler/mips/mips_codegen.o \
+	obj/recompiler/mips/mips_disasm.o
+endif
+
+# GPULIB from PCSX Rearmed with gpu_unai; the video output (vout_*) is the
+# port's own (src/port/r36sx/vout_x7.c) instead of gpulib/vout_port.c
+CFLAGS += -DUSE_GPULIB
+OBJS += obj/gpu/$(GPU)/gpulib_if.o obj/gpu/gpulib/gpu.o
+
+# Port: main, settings, buttons, screen
+OBJS += obj/port/$(PORT)/port.o obj/port/$(PORT)/x7_hw.o obj/port/$(PORT)/vout_x7.o
+
+# spu_pcsxrearmed with the ALSA output ("default" PCM, or $ALSA_NAME)
+# SPU updates twice per frame and forced XA updates: fewer dropouts on a
+# slow CPU (as on the GCW Zero / RG350 builds)
+CFLAGS += -DSPU_UPDATE_FREQ_DEFAULT=1 -DFORCED_XA_UPDATES_DEFAULT=1
+OBJS += obj/spu/$(SPU)/spu.o obj/spu/$(SPU)/dma.o obj/spu/$(SPU)/freeze.o \
+	obj/spu/$(SPU)/out.o obj/spu/$(SPU)/nullsnd.o \
+	obj/spu/$(SPU)/registers.o obj/spu/$(SPU)/alsa.o
+obj/spu/$(SPU)/out.o: CFLAGS += -DHAVE_ALSA
+
+ifeq ($(SUPPORT_CHD),1)
+OBJDIRS += obj/libchdr obj/libchdr/deps/lzma-19.00/src obj/libchdr/src
+CFLAGS += -DHAVE_CHD -D_7ZIP_ST -Isrc/libchdr/include/libchdr \
+	-Isrc/libchdr/include/dr_libs -Isrc/libchdr/include \
+	-Isrc/libchdr/deps/lzma-19.00/include
+OBJS += obj/libchdr/src/libchdr_bitstream.o obj/libchdr/src/libchdr_cdrom.o \
+	obj/libchdr/src/libchdr_chd.o obj/libchdr/src/libchdr_flac.o \
+	obj/libchdr/src/libchdr_huffman.o
+OBJS += obj/libchdr/deps/lzma-19.00/src/Alloc.o \
+	obj/libchdr/deps/lzma-19.00/src/Bra86.o \
+	obj/libchdr/deps/lzma-19.00/src/BraIA64.o \
+	obj/libchdr/deps/lzma-19.00/src/CpuArch.o \
+	obj/libchdr/deps/lzma-19.00/src/Delta.o \
+	obj/libchdr/deps/lzma-19.00/src/LzFind.o \
+	obj/libchdr/deps/lzma-19.00/src/Lzma86Dec.o \
+	obj/libchdr/deps/lzma-19.00/src/LzmaDec.o \
+	obj/libchdr/deps/lzma-19.00/src/LzmaEnc.o \
+	obj/libchdr/deps/lzma-19.00/src/Sort.o
+endif
+
+CXXFLAGS += $(CFLAGS) -fno-rtti -fno-exceptions
+
+$(TARGET): $(OBJS)
+	@echo Linking $(TARGET)...
+	$(HIDECMD)$(LD) $(OBJS) -o $@ $(CXXFLAGS) $(LDFLAGS) $(LIBS)
+
+obj/%.o: src/%.c
+	@echo Compiling $<...
+	$(HIDECMD)$(CC) $(CFLAGS) $(CFLAGS_C) -c $< -o $@
+
+obj/%.o: src/%.cpp
+	@echo Compiling $<...
+	$(HIDECMD)$(CXX) $(CXXFLAGS) -c $< -o $@
+
+obj/%.o: src/%.S
+	@echo Compiling $<...
+	$(HIDECMD)$(CC) $(CFLAGS) -c $< -o $@
+
+obj/%.o: src/%.s
+	@echo Compiling $<...
+	$(HIDECMD)$(CC) $(CFLAGS) -c $< -o $@
+
+$(sort $(OBJDIRS)):
+	$(HIDECMD)$(MD) $@
+
+maketree: $(sort $(OBJDIRS))
+
+clean:
+	$(RM) -r obj
+	$(RM) $(TARGET)
+
+.PHONY: all maketree clean
diff --git a/src/port/r36sx/port.c b/src/port/r36sx/port.c
