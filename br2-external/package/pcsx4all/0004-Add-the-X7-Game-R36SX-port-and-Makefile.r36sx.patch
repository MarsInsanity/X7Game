+#ifndef __PSXPORT_H__
+#define __PSXPORT_H__
+
+/*
+ * PCSX4ALL port for X7 Game on the R36SX (HiChip E3100, MIPS 74Kc, no GPU).
+ * Same interface as src/port/sdl/port.h, without SDL: video goes straight
+ * to /dev/fb0 (640x480 RGB565), input comes from evdev, audio from the
+ * spu_pcsxrearmed ALSA driver.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <math.h>
+#include <time.h>
+#include <ctype.h>
+#include <sys/types.h>
+#include <assert.h>
+
+#ifndef MAXPATHLEN
+#define MAXPATHLEN 256
+#endif
+
+extern char cheatsdir[MAXPATHLEN];
+
+struct ps1_controller {
+	uint8_t id;
+	uint8_t joy_right_ax0;
+	uint8_t joy_right_ax1;
+	uint8_t joy_left_ax0;
+	uint8_t joy_left_ax1;
+	uint8_t Vib[2];
+	uint8_t VibF[2];
+	uint8_t pad_mode;
+	uint8_t pad_controllertype;
+	uint8_t configmode;
+};
+
+extern struct ps1_controller player_controller[2];
+
+#define	CONFIG_VERSION	1
+
+INLINE int string_is_empty(const char *data)
+{
+	return (!data || (*data == '\0')) ? 1 : 0;
+}
+
+unsigned get_ticks(void);
+void wait_ticks(unsigned s);
+void pad_update(void);
+unsigned short pad_read(int num);
+
+void video_flip(void);
+void video_clear(void);
+void port_printf(int x, int y, const char *text);
+
+/* The menu draws into SCREEN, a cached 320x240 RGB565 canvas; video_flip()
+ * shows it doubled on the 640x480 screen. Game frames do not use SCREEN:
+ * vout_update() (vout_x7.c) writes them straight to the framebuffer. */
+extern unsigned short *SCREEN;
+extern int SCREEN_WIDTH, SCREEN_HEIGHT;
+
+char *GetMemcardPath(int slot);
+
+int state_load(int slot);
+int state_save(int slot);
+
+void update_memcards(int load_mcd);
+const char *bios_file_get();
+void check_spec_bios();
+
+void Rumble_Init();
+int trigger_rumble(uint8_t low, uint8_t high);
+int set_rumble_gain(unsigned gain);
+
+int SelectGame();
+int GameMenu();
+
+/* Menu buttons for frontend.c (it has no SDL here): the KEY_* bits of
+ * frontend.c for the buttons held now. port_menu_keys_reset() forgets the
+ * buttons held now until they are released (frontend.c's key_reset()). */
+unsigned int port_menu_keys(void);
+void port_menu_keys_reset(void);
+
+#endif
diff --git a/src/port/r36sx/vout_x7.c b/src/port/r36sx/vout_x7.c
new file mode 100644
index 0000000..de79852
--- /dev/null
+++ b/src/port/r36sx/vout_x7.c
@@ -0,0 +1,275 @@
+/*
+ * gpulib video output for X7 Game (R36SX): replaces gpu/gpulib/vout_port.c.
+ *
+ * The PS1 picture (256/320/368/384/512/640 wide, up to 240/256/480 lines,
+ * 15- or 24-bit) fills the 640x480 screen: the PS1 picture is 4:3 like the
+ * screen. With hardware scaling (X7 Game kernel patch 0019) it is written
+ * 1:1 and the display enlarges it (sharp for exact multiples, filtered
+ * otherwise); else the CPU scales it: 320x240 (most games) is an exact 2x,
+ * other sizes are nearest-neighbour. Lines the game does not display
+ * (screen.h < vres) stay black, centred like on a TV. Each frame goes to the
+ * hidden page and is shown at the next frame boundary (page flipping, patch
+ * 0020), so it never tears.
+ *
+ * The framebuffer is uncached: every screen line is built in a cached line
+ * buffer and written once (twice for 2x) with sequential 32-bit stores; the
+ * screen is never read.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "psxcommon.h"
+#include "port.h"
+#include "plugin_lib.h"
+#include "gpu/gpulib/gpu.h"
+#include "x7_hw.h"
+
+/* PS1 BGR555 -> RGB565 / BGR565, one pixel or two packed in 32 bits */
+#define RGB565(p)   ((((p) & 0x1f) << 11) | (((p) & 0x3e0) << 1) | (((p) >> 10) & 0x1f))
+#define BGR565(p)   ((((p) & 0x7fe0) << 1) | ((p) & 0x1f))
+#define RGB565X2(c) ((((c) & 0x001f001fu) << 11) | (((c) & 0x03e003e0u) << 1) | (((c) >> 10) & 0x001f001fu))
+#define BGR565X2(c) ((((c) & 0x7fe07fe0u) << 1) | ((c) & 0x001f001fu))
+/* 24-bit (MDEC movies) */
+#define RGB24_565(r, g, b) ((((r) & 0xf8) << 8) | (((g) & 0xfc) << 3) | ((b) >> 3))
+
+static uint32_t line[X7_FB_W / 2] __attribute__((aligned(32)));
+/* a VRAM line that wraps around the right edge, unwrapped */
+static uint16_t wrapbuf[1024 * 2] __attribute__((aligned(32)));
+static uint16_t xmap[X7_FB_W];   /* source pixel of each screen pixel */
+static int xmap_w = 0;
+
+/* where the picture was last drawn: the black bands above and below it are
+ * only written again when that changes (or after the menu), on each page */
+static int bands_top = -1, bands_h = -1, bands_todo = 0;
+
+void x7_vout_invalidate(void)
+{
+	bands_top = -1;
+}
+
+static void make_xmap(int w)
+{
+	int x;
+	for (x = 0; x < X7_FB_W; x++)
+		xmap[x] = (uint16_t)((x * w) / X7_FB_W);
+	xmap_w = w;
+}
+
+/* 15-bit line: src = first displayed pixel, w = PS1 width */
+static void build_line15(const uint16_t *src, int w, int bgr)
+{
+	int i;
+
+	if (w == 320) {
+		if (bgr) {
+			for (i = 0; i < 320; i++) {
+				uint32_t c = BGR565(src[i]);
+				line[i] = c | (c << 16);
+			}
+		} else {
+			for (i = 0; i < 320; i++) {
+				uint32_t c = RGB565(src[i]);
+				line[i] = c | (c << 16);
+			}
+		}
+	} else if (w == 640 && !((uintptr_t)src & 3)) {
+		const uint32_t *s32 = (const uint32_t *)(const void *)src;
+		if (bgr) {
+			for (i = 0; i < 320; i++)
+				line[i] = BGR565X2(s32[i]);
+		} else {
+			for (i = 0; i < 320; i++)
+				line[i] = RGB565X2(s32[i]);
+		}
+	} else {
+		if (xmap_w != w)
+			make_xmap(w);
+		if (bgr) {
+			for (i = 0; i < 320; i++) {
+				uint32_t a = src[xmap[2 * i]], b = src[xmap[2 * i + 1]];
+				line[i] = BGR565(a) | (BGR565(b) << 16);
+			}
+		} else {
+			for (i = 0; i < 320; i++) {
+				uint32_t a = src[xmap[2 * i]], b = src[xmap[2 * i + 1]];
+				line[i] = RGB565(a) | (RGB565(b) << 16);
+			}
+		}
+	}
+}
+
+/* 24-bit line: s8 = first byte of the displayed line, w = PS1 width */
+static void build_line24(const uint8_t *s8, int w, int bgr)
+{
+	int i;
+
+	if (xmap_w != w)
+		make_xmap(w);
+	for (i = 0; i < 320; i++) {
+		const uint8_t *a = s8 + 3 * xmap[2 * i];
+		const uint8_t *b = s8 + 3 * xmap[2 * i + 1];
+		uint32_t ca, cb;
+		if (bgr) {
+			ca = RGB24_565(a[2], a[1], a[0]);
+			cb = RGB24_565(b[2], b[1], b[0]);
+		} else {
+			ca = RGB24_565(a[0], a[1], a[2]);
+			cb = RGB24_565(b[0], b[1], b[2]);
+		}
+		line[i] = ca | (cb << 16);
+	}
+}
+
+/* 15-bit line, 1:1 (hardware scaling): w pixels into line[] */
+static void native_line15(const uint16_t *src, int w, int bgr)
+{
+	uint16_t *l16 = (uint16_t *)line;
+	int i;
+
+	if (bgr) {
+		for (i = 0; i < w; i++)
+			l16[i] = BGR565(src[i]);
+	} else {
+		for (i = 0; i < w; i++)
+			l16[i] = RGB565(src[i]);
+	}
+}
+
+/* 24-bit line, 1:1 */
+static void native_line24(const uint8_t *s8, int w, int bgr)
+{
+	uint16_t *l16 = (uint16_t *)line;
+	int i;
+
+	for (i = 0; i < w; i++, s8 += 3)
+		l16[i] = bgr ? RGB24_565(s8[2], s8[1], s8[0]) : RGB24_565(s8[0], s8[1], s8[2]);
+}
+
+/* the start of displayed VRAM line sy (unwrapped if it crosses the edge) */
+static const uint8_t *vram_line(int x0, int y0, int sy, int line_bytes)
+{
+	const uint16_t *row = gpu.vram + ((unsigned int)((y0 + sy) & 511) << 10);
+
+	if (x0 * 2 + line_bytes > 2048) {
+		int n = (line_bytes + 1) / 2, i;
+		for (i = 0; i < n; i++)
+			wrapbuf[i] = row[(x0 + i) & 1023];
+		return (const uint8_t *)wrapbuf;
+	}
+	return (const uint8_t *)row + x0 * 2;
+}
+
+void vout_update(void)
+{
+	const int x0 = gpu.screen.x;
+	const int y0 = gpu.screen.y;
+	const int w = gpu.screen.hres;     /* PS1 width */
+	const int vres = gpu.screen.vres;  /* 240, 256 or 480 */
+	const int rgb24 = gpu.status.rgb24;
+	const int bgr = x7_fb_bgr;
+	int h = gpu.screen.h;              /* lines displayed */
+	int out_h, top, r, last_sy = -1;
+	unsigned int acc = 0, step;
+	/* bytes of VRAM one displayed line covers */
+	const int line_bytes = rgb24 ? w * 3 : w * 2;
+
+	if (!x7_fb || w <= 0 || w > 1024 || vres <= 0 || h <= 0)
+		return;
+	if (h > vres)
+		h = vres;
+
+	out_h = h * X7_FB_H / vres;
+	if (out_h > X7_FB_H)
+		out_h = X7_FB_H;
+	top = (X7_FB_H - out_h) / 2;
+	step = ((unsigned int)vres << 16) / X7_FB_H;
+
+	/* the page drawn now was on the screen until the last flip took effect */
+	x7_begin_frame();
+
+	/* hardware scaling: the w x h picture 1:1 at the top-left of the page,
+	 * enlarged by the display into a 640 x out_h window (the PS1's 4:3);
+	 * even sizes, upscaling only */
+	if (x7_fb_hwscale && w <= X7_FB_W) {
+		int sw = w & ~1, sh = h & ~1, oh = out_h & ~1;
+		int sharp = (sw * 2 == X7_FB_W || sw == X7_FB_W) && (oh == 2 * sh || oh == sh);
+
+		if (sw >= 16 && sh >= 16 && sh <= oh &&
+		    x7_scale(sw, sh, X7_FB_W, oh, sharp) == 0) {
+			for (r = 0; r < sh; r++) {
+				const uint8_t *s8 = vram_line(x0, y0, r, line_bytes);
+
+				if (rgb24)
+					native_line24(s8, sw, bgr);
+				else
+					native_line15((const uint16_t *)(const void *)s8, sw, bgr);
+				x7_fb_write_words(r, line, sw / 2);
+			}
+			bands_top = -1;		/* the CPU path clears them again */
+			if (Config.ShowFps)
+				x7_fb_text(0, 0, pl_data.stats_msg);
+			x7_present();
+			return;
+		}
+	}
+	x7_scale(0, 0, 0, 0, 0);
+
+	if (top != bands_top || out_h != bands_h) {
+		bands_top = top;
+		bands_h = out_h;
+		bands_todo = 2;			/* once on each page */
+	}
+	if (bands_todo) {
+		x7_fb_clear_lines(0, top);
+		x7_fb_clear_lines(top + out_h, X7_FB_H);
+		bands_todo--;
+	}
+
+	for (r = 0; r < out_h; r++, acc += step) {
+		int sy = (int)(acc >> 16);
+
+		if (sy != last_sy) {
+			const uint8_t *s8 = vram_line(x0, y0, sy, line_bytes);
+
+			if (rgb24)
+				build_line24(s8, w, bgr);
+			else
+				build_line15((const uint16_t *)(const void *)s8, w, bgr);
+			last_sy = sy;
+		}
+		x7_fb_write_line(top + r, line);
+	}
+
+	if (Config.ShowFps)
+		x7_fb_text(8, 8, pl_data.stats_msg);
+	x7_present();
+}
+
+int vout_init(void)
+{
+	return 0;
+}
+
+int vout_finish(void)
+{
+	return 0;
+}
+
+/* PS1 display disabled: black screen */
+void vout_blank(void)
+{
+	x7_begin_frame();
+	x7_scale(0, 0, 0, 0, 0);
+	x7_fb_clear_lines(0, X7_FB_H);
+	x7_present();
+	x7_vout_invalidate();
+}
+
+void vout_set_config(const struct gpulib_config_t *config)
+{
+}
