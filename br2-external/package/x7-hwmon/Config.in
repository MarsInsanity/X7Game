config BR2_PACKAGE_X7_HWMON
	bool "x7-hwmon"
	depends on BR2_USE_MMU # fork, alsa-utils
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-utils
	select BR2_PACKAGE_ALSA_UTILS # amixer: volume keys
	select BR2_PACKAGE_ALSA_UTILS_AMIXER
	help
	  X7 Game's system daemons and tools:

	  x7-hwmon: the hardware monitor daemon (started by init). It
	  turns the console off with the power button or when the
	  battery runs low, handles the volume keys, and reports the
	  battery, charger, headphone jack and OTG port in the event
	  log /run/x7-events.log. "x7-hwmon --status" prints the
	  hardware state (x7-status, x7-console and the game list's
	  System information page use it).

	  x7-padd: the virtual gamepad "X7 Game Gamepad" that the
	  emulators read (started by init).

	  x7-browser: the temporary text-mode game list on the screen
	  (started by init).

	  x7-datapart: writes the data partition's (X7DATA) entry in
	  the SD card's partition table at the first start
	  (S05x7data), and reports whether X7DATA was closed cleanly.

	  x7-fbspeed: measures how fast programs can write the screen,
	  uncached and write-combined.

comment "x7-hwmon needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS
